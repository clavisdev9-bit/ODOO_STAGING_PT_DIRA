<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_me_master_data" model="ir.module.category">
        <field name="name">ME Master Data</field>
        <field name="sequence">50</field>
    </record>

    <record id="group_me_master_data_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_me_master_data"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_me_master_data_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_me_master_data"/>
        <field name="implied_ids" eval="[(4, ref('group_me_master_data_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
