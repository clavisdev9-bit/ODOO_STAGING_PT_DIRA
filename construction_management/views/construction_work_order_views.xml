<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_work_order_tree" model="ir.ui.view">
        <field name="name">construction.work.order.tree</field>
        <field name="model">construction.work.order</field>
        <field name="arch" type="xml">
            <list string="Work Orders" decoration-danger="state == 'late'"
                  decoration-success="state == 'done'" decoration-info="state == 'in_progress'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="description"/>
                <field name="boq_line_id"/>
                <field name="location"/>
                <field name="date_start"/>
                <field name="date_deadline"/>
                <field name="volume_plan"/>
                <field name="volume_actual"/>
                <field name="progress" widget="progressbar"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'in_progress'"
                       decoration-danger="state == 'late'"/>
            </list>
        </field>
    </record>

    <record id="view_construction_work_order_form" model="ir.ui.view">
        <field name="name">construction.work.order.form</field>
        <field name="model">construction.work.order</field>
        <field name="arch" type="xml">
            <form string="Work Order">
                <header>
                    <button name="action_start" string="Start" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_done" string="Mark Done" type="object"
                            class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done','cancelled')"/>
                    <button name="action_reset_draft" string="Reset" type="object"
                            invisible="state != 'cancelled'"/>
                    <button name="action_view_task" string="View Task" type="object"
                            invisible="not task_id"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="state != 'draft'"/></h1>
                    </div>
                    <group>
                        <group string="Work Order Info">
                            <field name="contract_id" readonly="state != 'draft'"/>
                            <field name="boq_line_id"
                                   domain="[('contract_id','=',contract_id)]"/>
                            <field name="description" readonly="state not in ('draft','in_progress')"/>
                            <field name="location"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Schedule">
                            <field name="date_start"/>
                            <field name="date_deadline"/>
                            <field name="assignee_ids" widget="many2many_tags"/>
                            <field name="task_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Volume &amp; Progress">
                        <group>
                            <field name="uom_id"/>
                            <field name="volume_plan"/>
                        </group>
                        <group>
                            <field name="volume_actual"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Instructions for field workers..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_work_order_search" model="ir.ui.view">
        <field name="name">construction.work.order.search</field>
        <field name="model">construction.work.order</field>
        <field name="arch" type="xml">
            <search string="Search Work Orders">
                <field name="name"/>
                <field name="description"/>
                <field name="contract_id"/>
                <filter string="In Progress" name="in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="Done" name="done" domain="[('state','=','done')]"/>
                <filter string="Late" name="late" domain="[('state','=','late')]"/>
                <group expand="0" string="Group By">
                    <filter name="grp_contract" string="Contract" context="{'group_by':'contract_id'}"/>
                    <filter name="grp_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="grp_boq" string="COP Item" context="{'group_by':'boq_line_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_work_order" model="ir.actions.act_window">
        <field name="name">Work Orders</field>
        <field name="res_model">construction.work.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_construction_work_order_search"/>
        <field name="context">{'search_default_in_progress': 1}</field>
    </record>

</odoo>
