<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_boq_line_tree" model="ir.ui.view">
        <field name="name">construction.boq.line.tree</field>
        <field name="model">construction.boq.line</field>
        <field name="arch" type="xml">
            <list string="BOQ Lines" decoration-success="progress_physical >= 100"
                  decoration-warning="progress_physical > 0 and progress_physical &lt; 100">
                <field name="contract_id"/>
                <field name="sequence" widget="handle"/>
                <field name="code"/>
                <field name="name"/>
                <field name="uom_id"/>
                <field name="volume_contract"/>
                <field name="unit_price_contract"/>
                <field name="subtotal_contract" sum="Total"/>
                <field name="weight_percent"/>
                <field name="progress_physical" widget="progressbar"/>
                <field name="volume_billed"/>
                <field name="rate_analysis_id"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_construction_boq_line_form" model="ir.ui.view">
        <field name="name">construction.boq.line.form</field>
        <field name="model">construction.boq.line</field>
        <field name="arch" type="xml">
            <form string="BOQ Line">
                <sheet>
                    <group>
                        <group string="BOQ Item">
                            <field name="contract_id"/>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="uom_id"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Quantities &amp; Price">
                            <field name="volume_contract"/>
                            <field name="unit_price_contract"/>
                            <field name="subtotal_contract"/>
                            <field name="weight_percent"/>
                        </group>
                    </group>
                    <group string="Progress Tracking">
                        <group>
                            <field name="progress_physical"/>
                            <field name="volume_actual"/>
                        </group>
                        <group>
                            <field name="volume_billed"/>
                            <field name="sale_order_line_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Rate Analysis">
                        <field name="rate_analysis_id" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_construction_boq_line_search" model="ir.ui.view">
        <field name="name">construction.boq.line.search</field>
        <field name="model">construction.boq.line</field>
        <field name="arch" type="xml">
            <search string="Search BOQ">
                <field name="name"/>
                <field name="code"/>
                <field name="contract_id"/>
                <filter string="Completed" name="done" domain="[('progress_physical','>=',100)]"/>
                <filter string="In Progress" name="wip" domain="[('progress_physical','&gt;',0),('progress_physical','&lt;',100)]"/>
                <filter string="Not Started" name="not_started" domain="[('progress_physical','=',0)]"/>
                <group expand="0" string="Group By">
                    <filter name="grp_contract" string="Contract" context="{'group_by':'contract_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_boq_line" model="ir.actions.act_window">
        <field name="name">Bill of Quantities</field>
        <field name="res_model">construction.boq.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_construction_boq_line_search"/>
    </record>

</odoo>
