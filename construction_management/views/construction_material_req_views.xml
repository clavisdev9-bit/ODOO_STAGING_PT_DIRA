<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_material_req_tree" model="ir.ui.view">
        <field name="name">construction.material.req.tree</field>
        <field name="model">construction.material.req</field>
        <field name="arch" type="xml">
            <list string="Material Requisitions" decoration-info="state == 'approved'"
                  decoration-success="state in ('purchased','received')"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="site"/>
                <field name="purpose"/>
                <field name="date_required"/>
                <field name="total_estimated" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'approved'"
                       decoration-success="state in ('purchased','received')"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_construction_material_req_form" model="ir.ui.view">
        <field name="name">construction.material.req.form</field>
        <field name="model">construction.material.req</field>
        <field name="arch" type="xml">
            <form string="Material Requisition">
                <header>
                    <button name="action_submit" string="Submit" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object"
                            class="btn-primary" invisible="state != 'submitted'"
                            groups="construction_management.group_construction_manager"/>
                    <button name="action_create_po" string="Create PO" type="object"
                            class="btn-primary" invisible="state != 'approved'"/>
                    <button name="action_view_po" string="View PO(s)" type="object"
                            invisible="not purchase_order_ids"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('purchased','received','cancelled')"/>
                    <button name="action_reset_draft" string="Reset" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,purchased,received"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="state != 'draft'"/></h1>
                    </div>
                    <group>
                        <group string="Request Info">
                            <field name="contract_id" readonly="state != 'draft'"/>
                            <field name="analytic_account_id" readonly="1"/>
                            <field name="requested_by"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Site &amp; Schedule">
                            <field name="site"/>
                            <field name="purpose"/>
                            <field name="date_required"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Material Lines" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="uom_id"/>
                                    <field name="qty_required"/>
                                    <field name="qty_on_hand" readonly="1"/>
                                    <field name="qty_to_order" readonly="1"/>
                                    <field name="vendor_id"/>
                                    <field name="estimated_price"/>
                                    <field name="estimated_total" readonly="1" sum="Total"/>
                                    <field name="status" readonly="1" optional="show"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                        <page string="Purchase Orders" name="po" invisible="not purchase_order_ids">
                            <field name="purchase_order_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="date_order"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer">
                        <field name="total_estimated" class="oe_subtotal_footer_separator"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_material_req_search" model="ir.ui.view">
        <field name="name">construction.material.req.search</field>
        <field name="model">construction.material.req</field>
        <field name="arch" type="xml">
            <search string="Search MPR">
                <field name="name"/>
                <field name="contract_id"/>
                <field name="site"/>
                <filter string="Draft" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
                <filter string="PO Created" name="purchased" domain="[('state','=','purchased')]"/>
                <group expand="0" string="Group By">
                    <filter name="grp_contract" string="Contract" context="{'group_by':'contract_id'}"/>
                    <filter name="grp_state" string="Status" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_construction_material_req" model="ir.actions.act_window">
        <field name="name">Material Requisitions</field>
        <field name="res_model">construction.material.req</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_construction_material_req_search"/>
    </record>

</odoo>
