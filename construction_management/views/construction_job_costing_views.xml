<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_construction_job_costing_tree" model="ir.ui.view">
        <field name="name">construction.job.costing.tree</field>
        <field name="model">construction.job.costing</field>
        <field name="arch" type="xml">
            <list string="Job Costing" create="false">
                <field name="contract_id"/>
                <field name="analytic_account_id"/>
                <field name="contract_value" sum="Contract Value"/>
                <field name="revenue_billed" sum="Billed"/>
                <field name="budget_total" sum="Budget"/>
                <field name="actual_cost" sum="Actual Cost"/>
                <field name="gross_margin" sum="Gross Margin"/>
                <field name="gross_margin_pct"/>
                <field name="physical_progress" widget="progressbar"/>
                <field name="currency_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_construction_job_costing_form" model="ir.ui.view">
        <field name="name">construction.job.costing.form</field>
        <field name="model">construction.job.costing</field>
        <field name="arch" type="xml">
            <form string="Job Costing Dashboard">
                <header>
                    <button name="action_refresh" string="Refresh" type="object"
                            class="btn-secondary" icon="fa-refresh"/>
                    <button name="action_view_analytic_lines" string="View Analytic Lines"
                            type="object" icon="fa-list"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="contract_id" readonly="id"/></h1>
                        <p>
                            <field name="analytic_account_id" readonly="1" class="text-muted"/>
                        </p>
                    </div>

                    <!-- KPI Summary Row -->
                    <div class="o_groups_sheet">
                        <div class="o_group">
                            <group string="📊 Contract Overview" col="2" colspan="2">
                                <field name="contract_value" readonly="1"/>
                                <field name="revenue_billed" readonly="1"/>
                                <field name="revenue_collected" readonly="1"/>
                                <field name="physical_progress" readonly="1" widget="progressbar"/>
                            </group>
                        </div>
                    </div>

                    <group string="Budget vs. Actual" col="5">
                        <group string="Cost Type" col="1">
                            <div><b>Material</b></div>
                            <div><b>Labor</b></div>
                            <div><b>Equipment</b></div>
                            <div><b>Sub-Contractor</b></div>
                            <div><b>Overhead</b></div>
                            <div class="mt4"><b>Total</b></div>
                        </group>
                        <group string="Budget">
                            <field name="budget_material" nolabel="1" readonly="1"/>
                            <field name="budget_labor" nolabel="1" readonly="1"/>
                            <field name="budget_equipment" nolabel="1" readonly="1"/>
                            <field name="budget_subcon" nolabel="1" readonly="1"/>
                            <field name="budget_overhead" nolabel="1" readonly="1"/>
                            <field name="budget_total" nolabel="1" readonly="1" class="fw-bold"/>
                        </group>
                        <group string="Actual">
                            <field name="actual_cost" nolabel="1" readonly="1"/>
                            <div/>
                            <div/>
                            <div/>
                            <div/>
                            <div/>
                        </group>
                    </group>

                    <group string="Profitability" col="2">
                        <group>
                            <field name="actual_revenue" readonly="1"/>
                            <field name="actual_cost" readonly="1"/>
                            <field name="gross_margin" readonly="1"/>
                            <field name="gross_margin_pct" readonly="1"/>
                        </group>
                        <group>
                            <field name="eac" readonly="1" string="EAC (Est. at Completion)"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_construction_job_costing_search" model="ir.ui.view">
        <field name="name">construction.job.costing.search</field>
        <field name="model">construction.job.costing</field>
        <field name="arch" type="xml">
            <search string="Search Job Costing">
                <field name="contract_id"/>
                <field name="analytic_account_id"/>
            </search>
        </field>
    </record>

    <record id="action_construction_job_costing" model="ir.actions.act_window">
        <field name="name">Job Costing</field>
        <field name="res_model">construction.job.costing</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_construction_job_costing_search"/>
    </record>

</odoo>
