<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Default Analytic Plan for Construction -->
    <record id="construction_analytic_plan" model="account.analytic.plan">
        <field name="name">Construction Projects</field>
        <field name="default_applicability">optional</field>
    </record>

    <!-- Service product for RA Billing retention line -->
    <record id="product_retention" model="product.product">
        <field name="name">Retention Deduction</field>
        <field name="type">service</field>
        <field name="sale_ok">False</field>
        <field name="purchase_ok">False</field>
    </record>

    <!-- Service product for Sub-Contract PO -->
    <record id="product_subcontract_service" model="product.product">
        <field name="name">Sub-Contract Service</field>
        <field name="type">service</field>
        <field name="purchase_ok">True</field>
        <field name="sale_ok">False</field>
    </record>

</odoo>
