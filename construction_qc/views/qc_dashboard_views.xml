<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_qc_dashboard" model="ir.actions.client">
        <field name="name">QC Dashboard</field>
        <field name="tag">construction_qc.qc_dashboard</field>
    </record>

    <!-- QC Summary pivot view -->
    <record id="view_qc_inspection_pivot" model="ir.ui.view">
        <field name="name">qc.inspection.pivot</field>
        <field name="model">qc.inspection</field>
        <field name="arch" type="xml">
            <pivot string="QC Summary">
                <field name="project_id" type="row"/>
                <field name="work_package" type="row"/>
                <field name="state" type="col"/>
                <field name="checklist_total" type="measure"/>
                <field name="checklist_pass" type="measure"/>
                <field name="checklist_fail" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_qc_inspection_graph" model="ir.ui.view">
        <field name="name">qc.inspection.graph</field>
        <field name="model">qc.inspection</field>
        <field name="arch" type="xml">
            <graph string="QC by Status" type="bar">
                <field name="inspection_date" interval="month" type="row"/>
                <field name="state" type="col"/>
            </graph>
        </field>
    </record>

    <record id="action_qc_summary_report" model="ir.actions.act_window">
        <field name="name">QC Summary Report</field>
        <field name="res_model">qc.inspection</field>
        <field name="view_mode">pivot,graph,list</field>
    </record>

    <record id="action_qc_progress_billing_report" model="ir.actions.act_window">
        <field name="name">Progress vs Billing</field>
        <field name="res_model">qc.inspection</field>
        <field name="view_mode">list,pivot</field>
        <field name="domain">[('state', 'in', ['approved', 'closed'])]</field>
        <field name="context">{'search_default_group_project': 1}</field>
    </record>

</odoo>
