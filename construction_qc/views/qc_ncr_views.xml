<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_qc_ncr_list" model="ir.ui.view">
        <field name="name">qc.ncr.list</field>
        <field name="model">qc.ncr</field>
        <field name="arch" type="xml">
            <list string="Non Conformance Reports"
                  decoration-danger="status == 'open'"
                  decoration-warning="status == 'in_progress'"
                  decoration-muted="status == 'closed'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="inspection_id"/>
                <field name="description"/>
                <field name="raised_by" widget="many2one_avatar_user"/>
                <field name="raised_date"/>
                <field name="ca_count" string="CAs"/>
                <field name="status" widget="badge"
                       decoration-danger="status == 'open'"
                       decoration-warning="status == 'in_progress'"
                       decoration-success="status == 'closed'"/>
            </list>
        </field>
    </record>

    <record id="view_qc_ncr_form" model="ir.ui.view">
        <field name="name">qc.ncr.form</field>
        <field name="model">qc.ncr</field>
        <field name="arch" type="xml">
            <form string="Non Conformance Report">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="open,in_progress,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Reference">
                            <field name="inspection_id"/>
                            <field name="project_id" readonly="1"/>
                            <field name="raised_by" widget="many2one_avatar_user"/>
                            <field name="raised_date"/>
                        </group>
                        <group string="Status">
                            <field name="status" widget="badge"
                                   decoration-danger="status == 'open'"
                                   decoration-warning="status == 'in_progress'"
                                   decoration-success="status == 'closed'"/>
                            <field name="ca_count" string="Corrective Actions"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Root Cause Analysis">
                        <field name="root_cause" nolabel="1" colspan="2"/>
                    </group>
                    <field name="corrective_action_ids"
                           context="{'default_ncr_id': id}">
                        <list editable="bottom">
                            <field name="name" readonly="1"/>
                            <field name="description"/>
                            <field name="pic_id" widget="many2one_avatar_user"/>
                            <field name="target_date"/>
                            <field name="completion_date"/>
                            <field name="status" widget="badge"
                                   decoration-danger="status == 'open'"
                                   decoration-warning="status == 'in_progress'"
                                   decoration-success="status in ('completed','verified')"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_qc_ncr_search" model="ir.ui.view">
        <field name="name">qc.ncr.search</field>
        <field name="model">qc.ncr</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="inspection_id"/>
                <filter string="Open" name="open" domain="[('status', '=', 'open')]"/>
                <filter string="In Progress" name="in_progress" domain="[('status', '=', 'in_progress')]"/>
                <filter string="Closed" name="closed" domain="[('status', '=', 'closed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_qc_ncr" model="ir.actions.act_window">
        <field name="name">NCR</field>
        <field name="res_model">qc.ncr</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_qc_ncr_search"/>
    </record>

</odoo>
