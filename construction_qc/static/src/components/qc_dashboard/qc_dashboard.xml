<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="construction_qc.QcDashboard">
        <div class="o_qc_dashboard container-fluid py-4 px-4">

            <!-- Loading -->
            <div t-if="state.loading" class="text-center py-5">
                <i class="fa fa-spin fa-spinner fa-3x text-muted"/>
                <p class="mt-3 text-muted">Loading dashboard...</p>
            </div>

            <t t-else="">
                <!-- Page title -->
                <div class="row mb-4">
                    <div class="col">
                        <h3 class="mb-0" style="color: #1a6b5a; font-weight: 700;">
                            <i class="fa fa-check-circle me-2"/>QC Dashboard
                        </h3>
                        <small class="text-muted">Quality Control — Mechanical &amp; Electrical</small>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-success btn-sm" t-on-click="() => this.openInspections('')">
                            <i class="fa fa-list me-1"/> All Inspections
                        </button>
                    </div>
                </div>

                <!-- KPI Cards -->
                <div class="row g-3 mb-4">
                    <!-- Total -->
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="card border-0 shadow-sm h-100 cursor-pointer qc-kpi-card"
                             t-on-click="() => this.openInspections('')"
                             style="border-left: 4px solid #1a6b5a !important;">
                            <div class="card-body text-center p-4">
                                <i class="fa fa-clipboard fa-2x mb-2" style="color: #1a6b5a;"/>
                                <div class="display-5 fw-bold" style="color: #1a6b5a;">
                                    <t t-out="state.total"/>
                                </div>
                                <div class="text-muted mt-1 fw-semibold">Total QC</div>
                            </div>
                        </div>
                    </div>

                    <!-- Approved -->
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="card border-0 shadow-sm h-100 cursor-pointer qc-kpi-card"
                             t-on-click="() => this.openInspections('approved')"
                             style="border-left: 4px solid #28a745 !important;">
                            <div class="card-body text-center p-4">
                                <i class="fa fa-check-circle fa-2x mb-2 text-success"/>
                                <div class="display-5 fw-bold text-success">
                                    <t t-out="state.approved"/>
                                </div>
                                <div class="text-muted mt-1 fw-semibold">Approved</div>
                            </div>
                        </div>
                    </div>

                    <!-- Pending -->
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="card border-0 shadow-sm h-100 cursor-pointer qc-kpi-card"
                             t-on-click="() => this.openInspections('submitted')"
                             style="border-left: 4px solid #ffc107 !important;">
                            <div class="card-body text-center p-4">
                                <i class="fa fa-clock-o fa-2x mb-2 text-warning"/>
                                <div class="display-5 fw-bold text-warning">
                                    <t t-out="state.pending"/>
                                </div>
                                <div class="text-muted mt-1 fw-semibold">Pending Review</div>
                            </div>
                        </div>
                    </div>

                    <!-- Rejected -->
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="card border-0 shadow-sm h-100 cursor-pointer qc-kpi-card"
                             t-on-click="() => this.openInspections('rejected')"
                             style="border-left: 4px solid #dc3545 !important;">
                            <div class="card-body text-center p-4">
                                <i class="fa fa-times-circle fa-2x mb-2 text-danger"/>
                                <div class="display-5 fw-bold text-danger">
                                    <t t-out="state.rejected"/>
                                </div>
                                <div class="text-muted mt-1 fw-semibold">Rejected</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Inspections Table -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white d-flex align-items-center py-3"
                         style="border-bottom: 2px solid #1a6b5a;">
                        <h5 class="mb-0 me-auto" style="color: #1a6b5a;">
                            <i class="fa fa-history me-2"/>Recent Inspections
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Reference</th>
                                    <th>Project</th>
                                    <th>Work Package</th>
                                    <th>Area</th>
                                    <th>Date</th>
                                    <th class="pe-3">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.recent" t-as="rec" t-key="rec.id"
                                    class="cursor-pointer"
                                    t-on-click="() => this.openRecord(rec.id)">
                                    <td class="ps-3 fw-semibold text-primary">
                                        <t t-out="rec.name"/>
                                    </td>
                                    <td><t t-out="rec.project"/></td>
                                    <td><t t-out="rec.work_package"/></td>
                                    <td><t t-out="rec.area"/></td>
                                    <td><t t-out="rec.date"/></td>
                                    <td class="pe-3">
                                        <span t-attf-class="badge rounded-pill bg-{{ rec.state_color }}">
                                            <t t-out="rec.state_label"/>
                                        </span>
                                    </td>
                                </tr>
                                <tr t-if="!state.recent.length">
                                    <td colspan="6" class="text-center text-muted py-5">
                                        <i class="fa fa-inbox fa-3x mb-3 d-block"/>
                                        No inspections yet. Start by creating a new QC Inspection.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </div>
    </t>
</templates>
