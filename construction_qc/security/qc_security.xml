<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ── Module category ── -->
        <record id="module_category_construction_qc" model="ir.module.category">
            <field name="name">Construction QC</field>
            <field name="sequence">200</field>
        </record>

        <!-- ── Groups ── -->
        <record id="group_qc_spv" model="res.groups">
            <field name="name">QC Supervisor</field>
            <field name="category_id" ref="module_category_construction_qc"/>
            <field name="comment">Field supervisor: creates and submits QC inspections.</field>
        </record>

        <record id="group_qc_pm" model="res.groups">
            <field name="name">QC Project Manager</field>
            <field name="category_id" ref="module_category_construction_qc"/>
            <field name="comment">PM: reviews and approves/rejects all inspections.</field>
        </record>

        <record id="group_qc_admin" model="res.groups">
            <field name="name">QC Administrator</field>
            <field name="category_id" ref="module_category_construction_qc"/>
            <field name="comment">Full access including configuration and deletion.</field>
        </record>

        <!-- ── Record rules ── -->

        <!-- SPV: can read/write only own inspections -->
        <record id="rule_qc_inspection_spv_own" model="ir.rule">
            <field name="name">QC Inspection: SPV sees own records</field>
            <field name="model_id" ref="model_qc_inspection"/>
            <field name="domain_force">[('spv_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_qc_spv'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- PM: sees all inspections -->
        <record id="rule_qc_inspection_pm_all" model="ir.rule">
            <field name="name">QC Inspection: PM full read/write</field>
            <field name="model_id" ref="model_qc_inspection"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_qc_pm'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- NCR: SPV sees own, PM sees all -->
        <record id="rule_qc_ncr_spv" model="ir.rule">
            <field name="name">QC NCR: SPV sees own</field>
            <field name="model_id" ref="model_qc_ncr"/>
            <field name="domain_force">[('inspection_id.spv_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_qc_spv'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_qc_ncr_pm" model="ir.rule">
            <field name="name">QC NCR: PM full access</field>
            <field name="model_id" ref="model_qc_ncr"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_qc_pm'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
