<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="res_config_settings_view_form_inherit_biometric_hr" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.biometric.hr</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr']/block[last()]" position="after">
                <block title="Biometric Integration" id="biometric_integration_settings">
                    <setting string="API Secret Key" help="Masukkan kunci rahasia unik untuk mengamankan API sinkronisasi.">
                        <div class="content-group">
                            <div class="mt16">
                                <label for="biometric_secret_key" string="Secret Key" class="o_light_label"/>
                                <field name="biometric_secret_key" class="oe_inline" placeholder="e.g., KunciSuperRahasia123"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>


    <record id="res_config_settings_view_form_inherit_biometric_attendance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.biometric.attendance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='kiosk_mode_setting_container']/setting[last()]" position="after">
                <setting string="Biometric Manager Menu" help="Tampilkan menu Biometric Manager di daftar Aplikasi.">
                     <field name="show_biometric_menu"/>
                </setting>
            </xpath>
        </field>
    </record>

</odoo>
