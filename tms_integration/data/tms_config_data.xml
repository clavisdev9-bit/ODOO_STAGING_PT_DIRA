<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            TMS Configuration System Parameters
            Set these values via Settings → Technical → Parameters → System Parameters
            after installation.
        -->

        <!-- URL TMS Backend (FastAPI) for Odoo to send webhooks TO -->
        <record id="tms_backend_url" model="ir.config_parameter">
            <field name="key">tms.backend.url</field>
            <field name="value">http://localhost:8000</field>
        </record>

        <!-- URL untuk endpoint webhook Odoo (where TMS posts T1/T2 triggers) -->
        <record id="tms_webhook_url" model="ir.config_parameter">
            <field name="key">tms.webhook.url</field>
            <field name="value">http://localhost:8000</field>
        </record>

        <!-- API Key / Bearer token: Odoo uses this to authenticate with TMS backend -->
        <record id="tms_api_key" model="ir.config_parameter">
            <field name="key">tms.api.key</field>
            <field name="value">CHANGE_ME_TMS_API_KEY</field>
        </record>

        <!-- Secret used to verify Bearer token on incoming TMS→Odoo webhooks -->
        <record id="tms_webhook_secret" model="ir.config_parameter">
            <field name="key">tms.webhook.secret</field>
            <field name="value">CHANGE_ME_WEBHOOK_SECRET</field>
        </record>

        <!-- HMAC secret for Odoo→TMS webhook signature verification -->
        <record id="tms_hmac_secret" model="ir.config_parameter">
            <field name="key">tms.hmac.secret</field>
            <field name="value">CHANGE_ME_HMAC_SECRET</field>
        </record>

        <!--
            Default expense product ID for hr.expense auto-creation (T7).
            Set to the internal ID of your "Vehicle Operational" expense product.
        -->
        <record id="tms_expense_product_id" model="ir.config_parameter">
            <field name="key">tms.expense.product_id</field>
            <field name="value"></field>
        </record>

    </data>
</odoo>
