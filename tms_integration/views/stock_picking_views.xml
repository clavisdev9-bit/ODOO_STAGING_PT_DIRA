<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit stock.picking form view — add TMS tab -->
    <record id="stock_picking_form_tms" model="ir.ui.view">
        <field name="name">stock.picking.form.tms</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- Add "Send to TMS" button in header -->
            <xpath expr="//header/button[last()]" position="after">
                <button name="action_send_to_tms" type="object"
                    string="Send to TMS"
                    class="btn-primary"
                    invisible="picking_type_code != 'outgoing' or state in ('done', 'cancel') or tms_status in ('assigned', 'picked_up', 'in_transit', 'delivered')"/>
            </xpath>

            <!-- Status bar badge for TMS status -->
            <xpath expr="//header" position="after">
                <div class="alert alert-info mb-0 py-1"
                    invisible="not tms_tracking_number">
                    <span class="fw-bold">TMS: </span>
                    <span invisible="not tms_tracking_number">
                        <field name="tms_tracking_number" readonly="1"/> —
                    </span>
                    <field name="tms_status" widget="badge" readonly="1"
                        decoration-success="tms_status == 'delivered'"
                        decoration-warning="tms_status in ('assigned', 'picked_up', 'in_transit')"
                        decoration-danger="tms_status == 'failed'"
                        decoration-muted="tms_status == 'not_sent'"/>
                </div>
            </xpath>

            <!-- TMS tab inside the notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="TMS" name="tms_info"
                    invisible="picking_type_code != 'outgoing'">
                    <group string="Assignment">
                        <group>
                            <field name="tms_tracking_number" readonly="1"/>
                            <field name="tms_status" readonly="1"/>
                            <field name="tms_urgency"/>
                            <field name="tms_sync_date" readonly="1"/>
                        </group>
                        <group>
                            <field name="tms_driver_name" readonly="1"/>
                            <field name="tms_vehicle_number" readonly="1"/>
                            <field name="tms_eta" readonly="1"/>
                            <field name="tms_actual_cost" readonly="1"/>
                            <field name="tms_currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Proof of Delivery"
                        invisible="not tms_pod_date">
                        <group>
                            <field name="tms_pod_date" readonly="1"/>
                            <field name="tms_pod_photo_count" readonly="1" string="Photos"/>
                            <field name="tms_signature_url" readonly="1" widget="url"/>
                        </group>
                        <group>
                            <field name="tms_pod_note" readonly="1"/>
                        </group>
                    </group>
                    <group string="Raw Data" groups="base.group_system">
                        <field name="tms_pod_photos" readonly="1" widget="text"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- List view: add TMS columns -->
    <record id="stock_picking_list_tms" model="ir.ui.view">
        <field name="name">stock.picking.list.tms</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="tms_tracking_number" optional="show" readonly="1"/>
                <field name="tms_status" widget="badge" optional="show" readonly="1"
                    decoration-success="tms_status == 'delivered'"
                    decoration-warning="tms_status in ('assigned', 'picked_up', 'in_transit')"
                    decoration-danger="tms_status == 'failed'"/>
                <field name="tms_driver_name" optional="hide" readonly="1"/>
                <field name="tms_eta" optional="hide" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- Send to TMS wizard view -->
    <record id="view_send_to_tms_wizard_form" model="ir.ui.view">
        <field name="name">tms.send.to.tms.wizard.form</field>
        <field name="model">tms.send.to.tms.wizard</field>
        <field name="arch" type="xml">
            <form string="Send to TMS">
                <sheet>
                    <group string="Delivery Order">
                        <field name="picking_id" invisible="1"/>
                        <field name="picking_name" string="Picking" readonly="1"/>
                        <field name="partner_name" string="Customer" readonly="1"/>
                        <field name="scheduled_date" readonly="1"/>
                    </group>
                    <group string="TMS Settings">
                        <field name="urgency" widget="radio"/>
                        <field name="notes" placeholder="Contoh: Fragile, handle with care..."/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object"
                        string="Kirim ke TMS" class="btn-primary"/>
                    <button string="Batal" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
