<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fleet_vehicle_form_tms" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.tms</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="TMS Capacity" name="tms_capacity">
                    <group string="Vehicle Classification">
                        <group>
                            <field name="tms_vehicle_type"/>
                            <field name="tms_active"/>
                        </group>
                    </group>
                    <group string="Load Capacity">
                        <group>
                            <field name="tms_max_weight" widget="float" string="Max Weight (kg)"/>
                            <field name="tms_max_volume" widget="float" string="Max Volume (m³)"/>
                        </group>
                        <group>
                            <field name="tms_cargo_length" string="Cargo Length (cm)"/>
                            <field name="tms_cargo_width" string="Cargo Width (cm)"/>
                            <field name="tms_cargo_height" string="Cargo Height (cm)"/>
                            <field name="tms_cargo_volume_m3" string="Computed Volume (m³)" readonly="1"/>
                        </group>
                    </group>
                    <group string="Operational Cost Parameters">
                        <group>
                            <field name="tms_fuel_efficiency" string="Fuel Efficiency (km/L)"/>
                            <field name="tms_daily_depreciation" string="Daily Depreciation (IDR)"/>
                        </group>
                        <group>
                            <field name="tms_maint_budget" string="Daily Maintenance Budget (IDR)"/>
                            <field name="tms_currency_id" invisible="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Fleet list: add TMS type column -->
    <record id="fleet_vehicle_list_tms" model="ir.ui.view">
        <field name="name">fleet.vehicle.list.tms</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='license_plate']" position="after">
                <field name="tms_vehicle_type" optional="show"/>
                <field name="tms_max_weight" optional="hide" string="Max W (kg)"/>
                <field name="tms_max_volume" optional="hide" string="Max V (m³)"/>
                <field name="tms_active" optional="show" string="TMS Active"/>
            </xpath>
        </field>
    </record>

</odoo>
