<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="tms_sync_log_list" model="ir.ui.view">
        <field name="name">tms.sync.log.list</field>
        <field name="model">tms.sync.log</field>
        <field name="arch" type="xml">
            <list string="TMS Sync Log" default_order="create_date desc"
                  decoration-danger="status == 'error'"
                  decoration-success="status == 'success'"
                  decoration-warning="status == 'pending'">
                <field name="create_date" string="Timestamp"/>
                <field name="trigger_code"/>
                <field name="direction"/>
                <field name="status" widget="badge"
                    decoration-success="status == 'success'"
                    decoration-danger="status == 'error'"
                    decoration-warning="status == 'pending'"/>
                <field name="picking_id"/>
                <field name="sale_order_id"/>
                <field name="tms_tracking_number"/>
                <field name="http_status_code"/>
                <field name="duration_ms" string="Duration (ms)"/>
                <field name="error_message" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="tms_sync_log_form" model="ir.ui.view">
        <field name="name">tms.sync.log.form</field>
        <field name="model">tms.sync.log</field>
        <field name="arch" type="xml">
            <form string="TMS Sync Log" create="false" edit="false">
                <sheet>
                    <group string="Event">
                        <group>
                            <field name="trigger_code"/>
                            <field name="direction"/>
                            <field name="status" widget="badge"/>
                            <field name="create_date" string="Timestamp"/>
                        </group>
                        <group>
                            <field name="picking_id"/>
                            <field name="sale_order_id"/>
                            <field name="tms_tracking_number"/>
                            <field name="http_status_code"/>
                            <field name="duration_ms"/>
                            <field name="retry_count"/>
                        </group>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" nolabel="1"/>
                    </group>
                    <group string="Request Payload">
                        <field name="request_payload" nolabel="1" widget="text"
                            style="font-family: monospace; font-size: 12px;"/>
                    </group>
                    <group string="Response Payload"
                        invisible="not response_payload">
                        <field name="response_payload" nolabel="1" widget="text"
                            style="font-family: monospace; font-size: 12px;"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tms_sync_log_search" model="ir.ui.view">
        <field name="name">tms.sync.log.search</field>
        <field name="model">tms.sync.log</field>
        <field name="arch" type="xml">
            <search string="TMS Sync Log">
                <field name="tms_tracking_number"/>
                <field name="picking_id"/>
                <field name="sale_order_id"/>
                <filter string="Error" name="error" domain="[('status', '=', 'error')]"/>
                <filter string="Success" name="success" domain="[('status', '=', 'success')]"/>
                <filter string="Today" name="today"
                    domain="[('create_date', '>=', datetime.datetime.combine(datetime.date.today(), datetime.time(0,0,0)))]"/>
                <separator/>
                <filter string="T1 SO Confirmed" name="t1" domain="[('trigger_code', '=', 'T1')]"/>
                <filter string="T6 Delivery Complete" name="t6" domain="[('trigger_code', '=', 'T6')]"/>
                <filter string="T7 Expense" name="t7" domain="[('trigger_code', '=', 'T7')]"/>
                <group expand="0" string="Group By">
                    <filter string="Trigger" name="group_trigger" context="{'group_by': 'trigger_code'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tms_sync_log" model="ir.actions.act_window">
        <field name="name">TMS Sync Log</field>
        <field name="res_model">tms.sync.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="tms_sync_log_search"/>
        <field name="context">{'search_default_error': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada log sinkronisasi TMS.
            </p>
        </field>
    </record>

</odoo>
