<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_tms" model="ir.ui.view">
        <field name="name">product.template.form.tms</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <!-- Add TMS Packaging group next to existing weight/volume -->
            <xpath expr="//group[@name='group_lots_and_weight']" position="after">
                <group string="TMS Packaging Dimensions" name="tms_packaging">
                    <group>
                        <field name="tms_pkg_length" string="Length (cm)"/>
                        <field name="tms_pkg_width" string="Width (cm)"/>
                        <field name="tms_pkg_height" string="Height (cm)"/>
                    </group>
                    <group>
                        <label for="tms_pkg_length" string=""/>
                        <div class="o_field_widget text-muted small">
                            Used by TMS 3D capacity visualizer
                        </div>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
