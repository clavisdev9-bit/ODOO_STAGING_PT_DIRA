<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="clavis_ai.ClavisAIChatAction">
  <div class="clavis-ai-shell">

    <!-- ═══════════ TOPBAR ═══════════ -->
    <div class="ca-topbar">
      <div class="ca-logo">
        <div class="ca-logo-dot"/>
        Clavis AI
      </div>
      <div class="ca-topbar-tabs">
        <t t-foreach="tabs" t-as="tab" t-key="tab.id">
          <div
            t-att-class="'ca-tab' + (state.activeTab === tab.id ? ' active' : '')"
            t-on-click="() => this.switchTab(tab.id)"
          >
            <t t-esc="tab.label"/>
          </div>
        </t>
      </div>
      <div class="ca-status-bar">
        <div class="ca-status-pill">
          <div class="ca-status-dot"/>
          Agent online
        </div>
      </div>
    </div>

    <!-- ═══════════ SIDEBAR ═══════════ -->
    <div class="ca-sidebar">
      <div class="ca-sidebar-section">Workspace</div>
      <div class="ca-nav-item active">
        <span class="ca-nav-icon">💬</span> AI Chat
      </div>
      <div class="ca-nav-item" t-on-click="() => this.switchTab('dashboard')">
        <span class="ca-nav-icon">📊</span> Dashboard
      </div>
      <div class="ca-nav-item" t-on-click="() => this.switchTab('logs')">
        <span class="ca-nav-icon">📋</span> Audit Logs
      </div>

      <div class="ca-sidebar-section">Quick Context</div>
      <div class="ca-nav-item" t-on-click="() => this.injectContext('current_user')">
        <span class="ca-nav-icon">🔗</span> My User
      </div>
      <div class="ca-nav-item" t-on-click="() => this.injectContext('draft_orders')">
        <span class="ca-nav-icon">🔗</span> Draft Orders
      </div>

      <div class="ca-sidebar-section">Session</div>
      <div class="ca-nav-item">
        <span class="ca-nav-icon">🔑</span>
        <span class="ca-mono ca-small" t-esc="'sess_' + shortSessionId"/>
      </div>
    </div>

    <!-- ═══════════ MAIN CONTENT ═══════════ -->
    <div class="ca-main">

      <!-- ── Chat Tab ── -->
      <t t-if="state.activeTab === 'chat'">
        <div class="ca-context-chips">
          <span class="ca-chip" t-on-click="() => this.injectContext('partner_id:7')">+ Partner #7</span>
          <span class="ca-chip" t-on-click="() => this.injectContext('sale_order')">+ Sale Order</span>
          <span class="ca-chip" t-on-click="() => this.injectContext('product:laptop')">+ Laptop Pro</span>
          <t t-foreach="state.activeContext" t-as="ctx" t-key="ctx">
            <span class="ca-chip ca-chip-active" t-esc="ctx"/>
          </t>
        </div>

        <div class="ca-chat-area" t-ref="chatArea">
          <!-- Empty state -->
          <t t-if="state.messages.length === 0 and !state.isTyping">
            <div class="ca-empty-state">
              <div class="ca-empty-icon">◈</div>
              <div class="ca-empty-title">Clavis AI ready</div>
              <div class="ca-empty-hint ca-mono">
                Try: "show me customer 7"<br/>
                "create quotation for john doe"<br/>
                "what are my open quotations"
              </div>
            </div>
          </t>

          <!-- Messages -->
          <t t-foreach="state.messages" t-as="msg" t-key="msg_index">

            <!-- User message -->
            <t t-if="msg.role === 'user'">
              <div class="ca-msg ca-msg-user">
                <div class="ca-avatar ca-avatar-user">U</div>
                <div class="ca-bubble ca-bubble-user" t-esc="msg.text"/>
              </div>
            </t>

            <!-- AI message -->
            <t t-else="">
              <div class="ca-msg">
                <div class="ca-avatar ca-avatar-ai">AI</div>
                <div class="ca-bubble ca-bubble-ai">
                  <span t-out="renderMarkdown(msg.text)"/>

                  <!-- Tool call indicator -->
                  <t t-if="msg.tool">
                    <div class="ca-tool-call">
                      <span class="ca-tool-icon">⚙</span>
                      <span class="ca-mono" t-esc="msg.tool"/>
                    </div>
                  </t>

                  <!-- Action / Info / List card -->
                  <t t-if="msg.card">
                    <div t-att-class="'ca-action-card' + (msg.card.disabled ? ' ca-card-disabled' : '')">

                      <!-- Info card (read-only data) -->
                      <t t-if="msg.card.type === 'info'">
                        <div class="ca-card-header">
                          <span>Customer record</span>
                        </div>
                        <div class="ca-card-body">
                          <t t-foreach="msg.card.displayEntries" t-as="entry" t-key="entry[0]">
                            <div class="ca-action-row">
                              <span class="ca-action-label" t-esc="entry[0]"/>
                              <span class="ca-action-value" t-esc="entry[1]"/>
                            </div>
                          </t>
                        </div>
                      </t>

                      <!-- Action card (requires confirmation) -->
                      <t t-elif="msg.card.type === 'action'">
                        <div class="ca-card-header">
                          <span>Pending action · confirm to execute</span>
                          <t t-if="msg.card.actionRequired">
                            <span class="ca-warn-text">⚠ requires approval</span>
                          </t>
                        </div>
                        <div class="ca-card-body">
                          <t t-foreach="msg.card.displayEntries" t-as="entry" t-key="entry[0]">
                            <div class="ca-action-row">
                              <span class="ca-action-label" t-esc="entry[0]"/>
                              <span class="ca-action-value" t-esc="entry[1]"/>
                            </div>
                          </t>
                          <t t-if="msg.card.actionRequired">
                            <div class="ca-action-btns">
                              <button
                                class="ca-btn-confirm"
                                t-on-click="() => this.confirmAction(msg.card.logId)"
                              >
                                ✓ Confirm &amp; Create in Odoo
                              </button>
                              <button
                                class="ca-btn-cancel"
                                t-on-click="() => this.cancelAction(msg.card.logId)"
                              >
                                ✕ Cancel
                              </button>
                            </div>
                          </t>
                        </div>
                      </t>

                      <!-- List card -->
                      <t t-elif="msg.card.type === 'list'">
                        <div class="ca-card-body">
                          <t t-foreach="msg.card.items" t-as="item" t-key="item_index">
                            <div class="ca-action-row">
                              <span class="ca-action-value ca-mono" t-esc="item"/>
                            </div>
                          </t>
                        </div>
                      </t>

                    </div>
                  </t>

                  <!-- Error state -->
                  <t t-if="msg.status === 'error'">
                    <div class="ca-error-badge">error</div>
                  </t>

                </div>
              </div>
            </t>

          </t>

          <!-- Typing indicator -->
          <t t-if="state.isTyping">
            <div class="ca-msg">
              <div class="ca-avatar ca-avatar-ai">AI</div>
              <div class="ca-bubble ca-bubble-ai">
                <div class="ca-typing">
                  <span/><span/><span/>
                </div>
              </div>
            </div>
          </t>
        </div>

        <!-- Input bar -->
        <div class="ca-input-bar">
          <div class="ca-input-wrap">
            <textarea
              class="ca-chat-input"
              t-ref="chatInput"
              rows="1"
              placeholder="Ask Clavis anything about your ERP…"
              t-model="state.inputText"
              t-on-keydown="onKeydown"
            />
          </div>
          <button class="ca-send-btn" t-on-click="sendMessage">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                 stroke-linecap="round" stroke-linejoin="round">
              <line x1="22" y1="2" x2="11" y2="13"/>
              <polygon points="22 2 15 22 11 13 2 9 22 2"/>
            </svg>
          </button>
        </div>
      </t>

      <!-- ── Dashboard Tab ── -->
      <t t-elif="state.activeTab === 'dashboard'">
        <div class="ca-tab-content">
          <div class="ca-section-title">Business Overview</div>
          <div class="ca-metric-grid-full">
            <div class="ca-metric-card-lg">
              <div class="ca-metric-label">OPEN QUOTATIONS</div>
              <div class="ca-metric-value" t-esc="state.metrics.open_orders"/>
              <div class="ca-metric-sub">draft state</div>
            </div>
            <div class="ca-metric-card-lg">
              <div class="ca-metric-label">TOTAL CUSTOMERS</div>
              <div class="ca-metric-value" t-esc="state.metrics.customers"/>
              <div class="ca-metric-sub">active partners</div>
            </div>
            <div class="ca-metric-card-lg">
              <div class="ca-metric-label">REVENUE MTD</div>
              <div class="ca-metric-value" t-esc="formatRevenue(state.metrics.revenue_mtd)"/>
              <div class="ca-metric-sub">confirmed orders</div>
            </div>
            <div class="ca-metric-card-lg">
              <div class="ca-metric-label">AI REQUESTS</div>
              <div class="ca-metric-value" t-esc="state.metrics.ai_requests"/>
              <div class="ca-metric-sub">your session</div>
            </div>
          </div>
        </div>
      </t>

      <!-- ── Logs Tab ── -->
      <t t-elif="state.activeTab === 'logs'">
        <div class="ca-tab-content">
          <div class="ca-section-title">Audit Logs (Recent)</div>
          <t t-if="state.auditLogs.length === 0">
            <div class="ca-empty-state">
              <div class="ca-empty-hint ca-mono">No AI requests in this session yet.</div>
            </div>
          </t>
          <t t-foreach="state.auditLogs" t-as="log" t-key="log.id">
            <div class="ca-log-item">
              <span class="ca-log-time ca-mono" t-esc="log.create_date"/>
              <span t-att-class="'ca-log-badge ' + (log.status === 'done' ? 'ok' : log.status === 'error' ? 'err' : 'warn')"
                    t-esc="log.status.toUpperCase()"/>
              <span class="ca-log-content" t-esc="log.message"/>
              <t t-if="log.tool_called">
                <span class="ca-log-tool ca-mono" t-esc="log.tool_called"/>
              </t>
            </div>
          </t>
        </div>
      </t>

    </div>

    <!-- ═══════════ RIGHT PANEL ═══════════ -->
    <div class="ca-panel">
      <div class="ca-panel-header">
        <span>Context panel</span>
        <div class="ca-panel-toggle">
          <button t-att-class="'ca-ptab' + (state.panelMode === 'metrics' ? ' active' : '')"
                  t-on-click="() => this.switchPanel('metrics')">Metrics</button>
          <button t-att-class="'ca-ptab' + (state.panelMode === 'tools' ? ' active' : '')"
                  t-on-click="() => this.switchPanel('tools')">Tools</button>
          <button t-att-class="'ca-ptab' + (state.panelMode === 'log' ? ' active' : '')"
                  t-on-click="() => this.switchPanel('log')">Log</button>
        </div>
      </div>
      <div class="ca-panel-body">

        <!-- Metrics panel -->
        <t t-if="state.panelMode === 'metrics'">
          <div class="ca-metric-grid">
            <div class="ca-metric-card">
              <div class="ca-metric-label">OPEN ORDERS</div>
              <div class="ca-metric-value" t-esc="state.metrics.open_orders"/>
              <div class="ca-metric-change">draft quotations</div>
            </div>
            <div class="ca-metric-card">
              <div class="ca-metric-label">CUSTOMERS</div>
              <div class="ca-metric-value" t-esc="state.metrics.customers"/>
              <div class="ca-metric-change">active</div>
            </div>
            <div class="ca-metric-card">
              <div class="ca-metric-label">REVENUE MTD</div>
              <div class="ca-metric-value ca-small-val"
                   t-esc="formatRevenue(state.metrics.revenue_mtd)"/>
              <div class="ca-metric-change">confirmed orders</div>
            </div>
            <div class="ca-metric-card">
              <div class="ca-metric-label">AI REQUESTS</div>
              <div class="ca-metric-value"
                   t-esc="state.messages.filter(m => m.role === 'ai').length"/>
              <div class="ca-metric-change">this session</div>
            </div>
          </div>
          <div class="ca-panel-section-label">Active context</div>
          <t t-if="state.activeContext.length === 0">
            <div class="ca-muted ca-mono ca-small">No context injected</div>
          </t>
          <t t-foreach="state.activeContext" t-as="ctx" t-key="ctx">
            <div class="ca-tool-chip">
              <div class="ca-tool-chip-icon">🔗</div>
              <div class="ca-tool-chip-name ca-mono" t-esc="ctx"/>
            </div>
          </t>
        </t>

        <!-- Tools panel -->
        <t t-elif="state.panelMode === 'tools'">
          <t t-foreach="state.tools" t-as="tool" t-key="tool.name">
            <div class="ca-tool-chip">
              <div class="ca-tool-chip-icon" t-esc="tool.icon"/>
              <div>
                <div class="ca-tool-chip-name ca-mono" t-esc="tool.name"/>
                <div class="ca-tool-chip-desc" t-esc="tool.desc"/>
              </div>
            </div>
          </t>
        </t>

        <!-- Log panel -->
        <t t-elif="state.panelMode === 'log'">
          <t t-if="state.auditLogs.length === 0">
            <div class="ca-log-item">
              <span class="ca-log-badge ok">OK</span>
              <span class="ca-log-content">Agent initialized · session active</span>
            </div>
          </t>
          <t t-foreach="state.auditLogs" t-as="log" t-key="log.id">
            <div class="ca-log-item">
              <span class="ca-log-time" t-esc="log.create_date"/>
              <span t-att-class="'ca-log-badge ' + (log.status === 'done' ? 'ok' : log.status === 'error' ? 'err' : 'warn')"
                    t-esc="log.status.toUpperCase()"/>
              <span class="ca-log-content" t-esc="log.message"/>
            </div>
          </t>
        </t>

      </div>
    </div>

  </div>
</t>

</templates>
