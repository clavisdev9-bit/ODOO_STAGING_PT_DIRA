<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List View ─────────────────────────────────────────────────────── -->
    <record id="clavis_ai_log_view_list" model="ir.ui.view">
        <field name="name">clavis.ai.log.list</field>
        <field name="model">clavis.ai.log</field>
        <field name="arch" type="xml">
            <list string="AI Request Logs" decoration-danger="status == 'error'"
                  decoration-muted="status == 'pending'" create="false">
                <field name="create_date" string="Time"/>
                <field name="user_id"/>
                <field name="session_id" optional="hide"/>
                <field name="message" string="User Message"/>
                <field name="tool_called" optional="show"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'done'"
                       decoration-warning="status == 'pending'"
                       decoration-danger="status == 'error'"/>
                <field name="action_required" string="Action?"/>
                <field name="latency_ms" string="Latency (ms)" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ── Form View ─────────────────────────────────────────────────────── -->
    <record id="clavis_ai_log_view_form" model="ir.ui.view">
        <field name="name">clavis.ai.log.form</field>
        <field name="model">clavis.ai.log</field>
        <field name="arch" type="xml">
            <form string="AI Request Log" create="false">
                <sheet>
                    <group>
                        <group string="Request">
                            <field name="create_date" string="Timestamp"/>
                            <field name="user_id"/>
                            <field name="session_id"/>
                            <field name="status" widget="badge"/>
                            <field name="latency_ms"/>
                        </group>
                        <group string="AI Execution">
                            <field name="tool_called"/>
                            <field name="action_required"/>
                        </group>
                    </group>
                    <group string="User Message">
                        <field name="message" nolabel="1"/>
                    </group>
                    <group string="AI Response">
                        <field name="response" nolabel="1"/>
                    </group>
                    <group string="Action Details" invisible="not action_details">
                        <field name="action_details" nolabel="1" widget="json"/>
                    </group>
                    <group string="Context" invisible="not context_data">
                        <field name="context_data" nolabel="1" widget="json"/>
                    </group>
                    <group string="Error" invisible="not error_message">
                        <field name="error_message" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search View ───────────────────────────────────────────────────── -->
    <record id="clavis_ai_log_view_search" model="ir.ui.view">
        <field name="name">clavis.ai.log.search</field>
        <field name="model">clavis.ai.log</field>
        <field name="arch" type="xml">
            <search string="Search Logs">
                <field name="message" string="Message"/>
                <field name="user_id"/>
                <field name="session_id"/>
                <separator/>
                <filter string="Done" name="done" domain="[('status','=','done')]"/>
                <filter string="Pending" name="pending" domain="[('status','=','pending')]"/>
                <filter string="Error" name="error" domain="[('status','=','error')]"/>
                <filter string="Action Required" name="action_required" domain="[('action_required','=',True)]"/>
                <separator/>
                <filter string="Today" name="today"
                        domain="[('create_date','&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)).strftime('%Y-%m-%d %H:%M:%S'))]"/>
                <group expand="0" string="Group By">
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'create_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Window Action ─────────────────────────────────────────────────── -->
    <record id="clavis_ai_log_action" model="ir.actions.act_window">
        <field name="name">AI Audit Logs</field>
        <field name="res_model">clavis.ai.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="clavis_ai_log_view_search"/>
        <field name="context">{'search_default_done': 1}</field>
    </record>

</odoo>
