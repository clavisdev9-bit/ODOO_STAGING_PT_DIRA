<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_dira" model="ir.ui.view">
        <field name="name">product.template.form.inherit.dira</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field name="dira_brand_id" options="{'no_create': False, 'no_open': True}"/>
                <field name="dira_sub_category_id" options="{'no_create': False, 'no_open': True}"/>
                <field name="dira_spesifikasi_id" options="{'no_create': False}"/>
                <field name="dira_division_id" options="{'no_create': False, 'no_open': True}"/>
            </xpath>
        </field>
    </record>
</odoo>