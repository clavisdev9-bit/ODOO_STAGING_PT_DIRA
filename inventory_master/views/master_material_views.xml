<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Views -->
    <!-- Division -->
    <record id="view_dira_division_list" model="ir.ui.view">
        <field name="name">dira.division.list</field>
        <field name="model">dira.division</field>
        <field name="arch" type="xml">
            <list string="Master Division">
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_dira_division_form" model="ir.ui.view">
        <field name="name">dira.division.form</field>
        <field name="model">dira.division</field>
        <field name="arch" type="xml">
            <form string="Division">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Division Name"/>
                        <h1><field name="name" placeholder="Division Name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Item Category -->
    <record id="view_dira_item_category_list" model="ir.ui.view">
        <field name="name">dira.item.category.list</field>
        <field name="model">dira.item.category</field>
