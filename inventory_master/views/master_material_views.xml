<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dira_brand_list" model="ir.ui.view">
        <field name="name">dira.brand.list</field>
        <field name="model">dira.brand</field>
        <field name="arch" type="xml">
            <list string="Master Brand">
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_dira_brand_form" model="ir.ui.view">
        <field name="name">dira.brand.form</field>
        <field name="model">dira.brand</field>
        <field name="arch" type="xml">
            <form string="Brand">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Brand Name"/>
                        <h1><field name="name" placeholder="e.g. Holcim"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dira_sub_category_list" model="ir.ui.view">
        <field name="name">dira.sub.category.list</field>
        <field name="model">dira.sub.category</field>
        <field name="arch" type="xml">
            <list string="Master Sub Category">
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_dira_sub_category_form" model="ir.ui.view">
        <field name="name">dira.sub.category.form</field>
        <field name="model">dira.sub.category</field>
        <field name="arch" type="xml">
            <form string="Sub Category">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Sub Category Name"/>
                        <h1><field name="name" placeholder="e.g. Beton"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dira_spesifikasi_list" model="ir.ui.view">
        <field name="name">dira.spesifikasi.list</field>
        <field name="model">dira.spesifikasi</field>
        <field name="arch" type="xml">
            <list string="Master Spesifikasi">
                <field name="code"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_dira_spesifikasi_form" model="ir.ui.view">
        <field name="name">dira.spesifikasi.form</field>
        <field name="model">dira.spesifikasi</field>
        <field name="arch" type="xml">
            <form string="Spesifikasi">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only" string="Spec Name"/>
                        <h1><field name="name" placeholder="e.g. Kuat Tekan 25 MPa"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dira_brand" model="ir.actions.act_window">
        <field name="name">Master Brand</field>
        <field name="res_model">dira.brand</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_dira_sub_category" model="ir.actions.act_window">
        <field name="name">Master Sub Category</field>
        <field name="res_model">dira.sub.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_dira_spesifikasi" model="ir.actions.act_window">
        <field name="name">Master Spesifikasi</field>
        <field name="res_model">dira.spesifikasi</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dira_master_material_root" name="Master" parent="stock.menu_stock_root" sequence="99"/>
    
    <menuitem id="menu_dira_brand" name="Brand" parent="menu_dira_master_material_root" action="action_dira_brand" sequence="1"/>
    <menuitem id="menu_dira_sub_category" name="Sub Category" parent="menu_dira_master_material_root" action="action_dira_sub_category" sequence="2"/>
    <menuitem id="menu_dira_spesifikasi" name="Spesifikasi" parent="menu_dira_master_material_root" action="action_dira_spesifikasi" sequence="3"/>

</odoo>