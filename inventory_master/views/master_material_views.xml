    <!-- Menus -->
    <menuitem id="menu_dira_master_material_root" name="Master" parent="stock.menu_stock_root" sequence="99"/>
    
    <menuitem id="menu_dira_division" name="Division" parent="menu_dira_master_material_root" action="action_dira_division" sequence="1"/>
    <menuitem id="menu_dira_item_category" name="Item Category" parent="menu_dira_master_material_root" action="action_dira_item_category" sequence="2"/>
    <menuitem id="menu_dira_sub_category" name="Sub Category" parent="menu_dira_master_material_root" action="action_dira_sub_category" sequence="3"/>
    <menuitem id="menu_dira_brand" name="Brand" parent="menu_dira_master_material_root" action="action_dira_brand" sequence="4"/>
    <menuitem id="menu_dira_specification" name="Specification" parent="menu_dira_master_material_root" action="action_dira_specification" sequence="5"/>
