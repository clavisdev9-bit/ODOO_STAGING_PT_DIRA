<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_event_tenant_list" model="ir.ui.view">
        <field name="name">event.tenant.list - view</field>
        <field name="model">event.tenant</field>
        <field name="arch" type="xml">
            <list string="Tenant">
                <field name="name"/>
                <field name="booth_code"/>
                <field name="description"/>
                <field name="floor"/>
            </list>
        </field>
    </record>

    <record id="view_event_tenant_form" model="ir.ui.view">
        <field name="name">event.tenant.form - view</field>
        <field name="model">event.tenant</field>
        <field name="arch" type="xml">
            <form string="Tenant">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="booth_code"/>
                        </group>
                        <group>
                            <field name="description"/>
                            <field name="floor"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="User">
                            <field name="user_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_product_form_inherit_tenant" model="ir.ui.view">
        <field name="name">product.product.form.inherit.tenant</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='type']" position="before">
                <field name="tenant_id"/>
            </xpath>
        </field>
    </record>

    <record id="action_event_tenant" model="ir.actions.act_window">
        <field name="name">Tenant</field>
        <field name="res_model">event.tenant</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                Please create a record
            </p>
        </field>
    </record>

    <menuitem id="menu_event_tenant"
              name="Tenant"
              action="action_event_tenant"
              parent="menu_event_order_root"
              sequence="20"/>
</odoo>