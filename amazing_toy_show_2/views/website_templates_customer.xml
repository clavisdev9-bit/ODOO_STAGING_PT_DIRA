    <template id="customer_pickup_tracking_page">
        <t t-call="website.layout">
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <div class="container py-4" style="max-width: 500px; background-color: #fffdf9; min-height: 100vh;">
                <div class="d-flex align-items-center mb-4">
                    <h4 class="fw-bold mb-0">Pickup Status</h4>
                </div>
                <div class="alert alert-warning border-0 shadow-sm"
                     style="border-radius: 15px; background-color: #e9f5db;">
                    <p class="small mb-0 text-dark">
                        Visit each booth and show your QR code. Items update automatically.
                    </p>
                </div>
                <t t-set="lines_by_tenant"
                   t-value="order.line_ids.read_group([('order_id', '=', order.id)], ['tenant_id'], ['tenant_id'])"/>
                <t t-foreach="order.line_ids.mapped('tenant_id')" t-as="tenant">
                    <div class="mt-4">
                        <h6 class="text-muted fw-bold small">
                            <t t-esc="tenant.name"/>
                            •
                            <t t-esc="tenant.floor.upper()"/>, <t t-esc="tenant.booth_code"/>
                        </h6>
                        <t t-foreach="order.line_ids.filtered(lambda l: l.tenant_id == tenant)" t-as="line">
                            <div class="card border-0 shadow-sm mb-2" style="border-radius: 12px;">
                                <div class="card-body d-flex align-items-center justify-content-between py-3">
                                    <div>
                                        <div class="fw-bold text-dark">
                                            <t t-esc="line.product_id.name"/>
                                        </div>
                                        <div class="small text-muted">
                                            <t t-esc="line.qty"/>
                                            · Rp
                                            <t t-esc="'{:,.0f}'.format(line.price_unit).replace(',', '.')"/>
                                        </div>
                                    </div>
                                    <span t-if="line.is_handed_over"
                                          class="badge rounded-pill bg-success text-white p-2 px-3">
                                        Done
                                        <i class="fa fa-check ms-1"/>
                                    </span>
                                    <span t-else="" class="badge rounded-pill bg-warning p-2 px-3"
                                          style="background-color: #fff3cd;">
                                        Ready
                                    </span>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
                <div class="fixed-bottom p-3 bg-white border-top shadow-lg" style="border-radius: 25px 25px 0 0;">
                    <div class="text-center mb-3">
                        <div class="small text-muted mb-1">Collected</div>
                        <h3 class="fw-bold mb-2">
                            <t t-esc="len(order.line_ids.filtered(lambda l: l.is_handed_over))"/>
                            /
                            <t t-esc="len(order.line_ids)"/>
                            items
                        </h3>
                        <div class="progress" style="height: 10px; border-radius: 5px;">
                            <t t-set="progress"
                               t-value="(len(order.line_ids.filtered(lambda l: l.is_handed_over)) / len(order.line_ids)) * 100"/>
                            <div class="progress-bar bg-success progress-bar-striped progress-bar-animated"
                                 role="progressbar" t-attf-style="width: #{progress}%"/>
                        </div>
                    </div>
                    <button class="btn btn-danger w-100 rounded-pill py-3 fw-bold shadow js_show_barcode">
                        <i class="fa fa-barcode me-2"/>
                        Show Transaction Barcode
                    </button>
                </div>
                <div style="height: 180px;"/>
            </div>
            <div class="modal fade" id="modalBarcode" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered px-4">
                    <div class="modal-content border-0" style="border-radius: 30px;">
                        <div class="modal-body text-center p-5">
                            <h5 class="fw-bold mb-4">Transaction Barcode</h5>
                            <div class="bg-light p-4 d-inline-block mb-3" style="border-radius: 20px;">
                                <div id="qrcode2" class="mb-3"/>
                            </div>
                            <h3 class="fw-bold mb-2">
                                <t t-esc="order.name"/>
                            </h3>
                            <p class="text-muted small px-3">
                                Show this to the tenant booth staff to scan
                            </p>
                            <button type="button" class="btn btn-light w-100 rounded-pill py-3 fw-bold mt-4"
                                    data-bs-dismiss="modal" style="background-color: #f8f3e6;">
                                Close
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"/>
            <script>
                document.addEventListener("DOMContentLoaded", function() {
                    const transactionID = "<t t-esc='order.name'/>";
                    new QRCode(document.getElementById("qrcode2"), {
                        text: transactionID,
                        width: 200,
                        height: 200,
                        colorDark : "#000000",
                        colorLight : "#ffffff",
                        correctLevel : QRCode.CorrectLevel.H
                    });

                    const orderToken = "<t t-esc='order.token'/>";
                    let currentCollected = <t t-esc="len(order.line_ids.filtered(lambda l: l.is_handed_over))"/>;
                    const checkStatus = () => {
                        fetch('/checkout/pickup_status/check', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ params: { token: orderToken } })
                        })
                        .then(response => response.json())
                        .then(data => {
                            const result = data.result;
                            if (result.all_done) {
                                window.location.href = '/tenants';
                            } else if (result.handover_count !== currentCollected) {
                                location.reload();
                            }
                        })
                        .catch(err => console.error("Polling error:", err));
                    };
                    setInterval(checkStatus, 3000);
                });
            </script>
        </t>
    </template>

