                            <span>Payment method:</span>
                            <span>
                                <t t-esc="order.payment_method.upper()"/>
                            </span>
                        </div>
                        <div class="mt-5 text-center">
                            <div class="p-3 bg-light rounded-3">
                                <p class="small text-muted mb-0">Thanks for shopping!</p>
                                <p class="small text-muted mb-0">Goods that have been purchased cannot be exchanged or returned.</p>
                            </div>
                            <a href="/tenants" class="btn btn-outline-danger btn-sm mt-4 rounded-pill px-4">Back to shopping</a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>
