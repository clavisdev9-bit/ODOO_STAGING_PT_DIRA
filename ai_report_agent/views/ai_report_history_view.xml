<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_ai_report_history_form" model="ir.ui.view">
        <field name="name">ai.report.history.form</field>
        <field name="model">ai.report.history</field>
        <field name="arch" type="xml">
            <form string="Report History">
                <header>
                    <button name="action_regenerate"
                            string="Regenerate"
                            type="object"
                            class="btn-primary"
                            invisible="[('status', '=', 'processing')]"
                            icon="fa-refresh"/>
                    <button name="action_download_pdf"
                            string="Download PDF"
                            type="object"
                            invisible="[('status', '!=', 'done')]"
                            icon="fa-file-pdf-o"/>
                    <button name="action_download_xlsx"
                            string="Download Excel"
                            type="object"
                            invisible="[('status', '!=', 'done')]"
                            icon="fa-file-excel-o"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,processing,done,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Request Info">
                            <field name="user_id" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                            <field name="session_id" readonly="1"/>
                            <field name="processing_time_ms" readonly="1" string="Processing Time (ms)"/>
                        </group>
                        <group string="Report Details">
                            <field name="report_type"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="ai_confidence" widget="float" string="AI Confidence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="User Request" name="request">
                            <field name="user_message" widget="text" readonly="1"
                                   style="min-height: 80px;"/>
                        </page>
                        <page string="Interpreted Intent" name="intent">
                            <field name="interpreted_intent" widget="text" readonly="1"
                                   style="min-height: 150px; font-family: monospace; font-size: 11px;"/>
                        </page>
                        <page string="AI Insight" name="insight">
                            <field name="insight_text" widget="text" readonly="1"
                                   style="min-height: 100px;"/>
                        </page>
                        <page string="Output Files" name="files">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Error" name="error"
                              invisible="[('status', '!=', 'error')]">
                            <field name="error_message" widget="text" readonly="1"
                                   style="color: red; min-height: 80px;"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_ai_report_history_list" model="ir.ui.view">
        <field name="name">ai.report.history.list</field>
        <field name="model">ai.report.history</field>
        <field name="arch" type="xml">
            <list string="Report History" decoration-danger="status=='error'"
                  decoration-success="status=='done'" decoration-info="status=='processing'">
                <field name="name"/>
                <field name="user_id"/>
                <field name="report_type"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="ai_confidence" widget="float_factor" string="Confidence"/>
                <field name="status" widget="badge"
                       decoration-success="status=='done'"
                       decoration-warning="status=='processing'"
                       decoration-danger="status=='error'"/>
                <field name="create_date"/>
                <field name="processing_time_ms" string="Time (ms)"/>
                <button name="action_download_pdf" string="PDF" type="object"
                        icon="fa-file-pdf-o"
                        invisible="[('status', '!=', 'done')]"/>
                <button name="action_download_xlsx" string="Excel" type="object"
                        icon="fa-file-excel-o"
                        invisible="[('status', '!=', 'done')]"/>
            </list>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_ai_report_history_search" model="ir.ui.view">
        <field name="name">ai.report.history.search</field>
        <field name="model">ai.report.history</field>
        <field name="arch" type="xml">
            <search string="Search Report History">
                <field name="name" string="Request"/>
                <field name="user_id"/>
                <field name="report_type"/>
                <filter string="Done" name="done" domain="[('status','=','done')]"/>
                <filter string="Error" name="error" domain="[('status','=','error')]"/>
                <filter string="Processing" name="processing" domain="[('status','=','processing')]"/>
                <separator/>
                <filter string="This Month" name="this_month"
                        domain="[('create_date','>=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="My Requests" name="my_requests"
                        domain="[('user_id','=',uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Report Type" name="group_type" context="{'group_by': 'report_type'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="User" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_ai_report_history" model="ir.actions.act_window">
        <field name="name">Report History</field>
        <field name="res_model">ai.report.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ai_report_history_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No report requests yet
            </p>
            <p>
                Use the "Generate Report AI" button or call POST /ai/report
                to start generating reports from natural language.
            </p>
        </field>
    </record>
</odoo>
