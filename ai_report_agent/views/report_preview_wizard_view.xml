<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_report_preview_wizard_form" model="ir.ui.view">
        <field name="name">report.preview.wizard.form</field>
        <field name="model">report.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Report Preview">
                <sheet>
                    <div class="o_form_view">
                        <!-- Preview state -->
                        <group invisible="[('state', '!=', 'preview')]">
                            <group string="Your Request">
                                <field name="user_message" widget="text" readonly="1"
                                       style="min-height: 60px;"/>
                            </group>
                            <group string="AI Interpretation (JSON)">
                                <field name="interpreted_intent" widget="text" readonly="1"
                                       style="font-family: monospace; font-size: 11px; min-height: 120px;"/>
                            </group>
                            <group string="Adjust Report Settings">
                                <group>
                                    <field name="report_type"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                </group>
                                <group>
                                    <field name="output_format_pdf"/>
                                    <field name="output_format_xlsx"/>
                                </group>
                            </group>
                            <group string="AI Insight" invisible="[('insight_text', '=', False)]">
                                <field name="insight_text" widget="text" readonly="1"
                                       nolabel="1" style="min-height: 80px;"/>
                            </group>
                        </group>

                        <!-- Done state -->
                        <group invisible="[('state', '!=', 'done')]">
                            <div class="alert alert-success" role="alert">
                                <strong>Report Generated Successfully!</strong>
                                <p>Your report is ready for download.</p>
                            </div>
                            <group string="Download Links">
                                <field name="download_url_pdf" widget="url" readonly="1"
                                       invisible="[('download_url_pdf', '=', '')]"/>
                                <field name="download_url_xlsx" widget="url" readonly="1"
                                       invisible="[('download_url_xlsx', '=', '')]"/>
                            </group>
                        </group>
                    </div>
                </sheet>
                <footer>
                    <button name="action_generate"
                            string="Generate Report"
                            type="object"
                            class="btn-primary"
                            invisible="[('state', '!=', 'preview')]"/>
                    <button name="action_close"
                            string="Close"
                            type="object"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_report_preview_wizard" model="ir.actions.act_window">
        <field name="name">Generate AI Report</field>
        <field name="res_model">report.preview.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
