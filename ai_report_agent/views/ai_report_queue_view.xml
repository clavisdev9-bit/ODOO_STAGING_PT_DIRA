<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_ai_report_queue_form" model="ir.ui.view">
        <field name="name">ai.report.queue.form</field>
        <field name="model">ai.report.queue</field>
        <field name="arch" type="xml">
            <form string="Report Queue Job">
                <header>
                    <field name="status" widget="statusbar"
                           statusbar_visible="pending,running,done,failed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Job Info">
                            <field name="history_id"/>
                            <field name="status" widget="badge"
                                   decoration-success="status=='done'"
                                   decoration-warning="status in ('pending','running')"
                                   decoration-danger="status=='failed'"/>
                            <field name="retry_count"/>
                            <field name="max_retries"/>
                        </group>
                        <group string="Timing">
                            <field name="scheduled_at"/>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                        </group>
                    </group>
                    <group string="Payload">
                        <field name="payload" widget="text" readonly="1"
                               style="font-family: monospace; font-size: 11px; min-height: 150px;"/>
                    </group>
                    <group string="Error" invisible="[('status', '!=', 'failed')]">
                        <field name="error_message" widget="text" readonly="1"
                               style="color: red;"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_ai_report_queue_list" model="ir.ui.view">
        <field name="name">ai.report.queue.list</field>
        <field name="model">ai.report.queue</field>
        <field name="arch" type="xml">
            <list string="Report Queue"
                  decoration-success="status=='done'"
                  decoration-warning="status in ('pending','running')"
                  decoration-danger="status=='failed'">
                <field name="history_id"/>
                <field name="status" widget="badge"
                       decoration-success="status=='done'"
                       decoration-warning="status in ('pending','running')"
                       decoration-danger="status=='failed'"/>
                <field name="retry_count"/>
                <field name="scheduled_at"/>
                <field name="started_at"/>
                <field name="finished_at"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_ai_report_queue" model="ir.actions.act_window">
        <field name="name">Report Queue</field>
        <field name="res_model">ai.report.queue</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No queued jobs
            </p>
            <p>
                Large report requests are automatically queued here
                and processed by a background scheduler.
            </p>
        </field>
    </record>
</odoo>
