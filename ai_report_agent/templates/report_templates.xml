<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================================================================
         Base layout shared by all AI Report templates
         ================================================================ -->
    <template id="report_layout_base" name="AI Report Base Layout">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <!-- Report Header -->
                    <div class="row mb-4">
                        <div class="col-8">
                            <h2 t-esc="report_title" class="text-primary"/>
                            <p class="text-muted">
                                Period: <strong t-esc="date_from"/> — <strong t-esc="date_to"/>
                            </p>
                        </div>
                        <div class="col-4 text-right">
                            <p t-esc="company.name" class="font-weight-bold"/>
                            <p t-esc="company.street"/>
                            <p><t t-esc="company.city"/><t t-if="company.zip">, <t t-esc="company.zip"/></t></p>
                        </div>
                    </div>
                    <hr/>
                    <!-- Content injected by child templates -->
                    <t t-out="0"/>
                    <!-- Footer -->
                    <div class="row mt-4">
                        <div class="col-12 text-muted text-center" style="font-size:10px;">
                            Generated by AI Report Agent • <t t-esc="company.name"/>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <!-- ================================================================
         Sales Report Template
         ================================================================ -->
    <template id="report_sales_document" name="AI Sales Report">
        <t t-set="report_title">Sales Report</t>
        <t t-call="ai_report_agent.report_layout_base">
            <!-- KPI Cards -->
            <div class="row mb-4">
                <div class="col-4">
                    <div class="card border-primary">
                        <div class="card-body text-center">
                            <h5 class="card-title text-primary">Total Revenue</h5>
                            <h3>
                                <t t-esc="data.get('currency', '')"/>
                                <t t-esc="'{:,.2f}'.format(data.get('total_revenue', 0))"/>
                            </h3>
                        </div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="card border-success">
                        <div class="card-body text-center">
                            <h5 class="card-title text-success">Total Orders</h5>
                            <h3 t-esc="data.get('order_count', 0)"/>
                        </div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="card border-info">
                        <div class="card-body text-center">
                            <h5 class="card-title text-info">Confirmed Orders</h5>
                            <h3 t-esc="data.get('confirmed_count', 0)"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Top Products Table -->
            <t t-if="data.get('top_products')">
                <h4 class="mt-4">Top Products</h4>
                <table class="table table-striped table-sm">
                    <thead class="thead-dark">
                        <tr>
                            <th>#</th>
                            <th>Product</th>
                            <th class="text-right">Qty Sold</th>
                            <th class="text-right">Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data.get('top_products', [])" t-as="prod">
                            <tr>
                                <td t-esc="prod_index + 1"/>
                                <td t-esc="prod.get('name', '')"/>
                                <td class="text-right" t-esc="'{:,.2f}'.format(prod.get('qty', 0))"/>
                                <td class="text-right" t-esc="'{:,.2f}'.format(prod.get('amount', 0))"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>

            <!-- Orders Table -->
            <t t-if="data.get('orders')">
                <h4 class="mt-4">Sales Orders</h4>
                <table class="table table-bordered table-sm">
                    <thead class="thead-dark">
                        <tr>
                            <th>Order</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th class="text-right">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data.get('orders', [])[:100]" t-as="order">
                            <tr>
                                <td t-esc="order.get('name', '')"/>
                                <td t-esc="order.get('partner', '')"/>
                                <td t-esc="order.get('date', '')"/>
                                <td t-esc="order.get('state', '')"/>
                                <td class="text-right" t-esc="'{:,.2f}'.format(order.get('amount', 0))"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <p t-if="len(data.get('orders', [])) > 100" class="text-muted">
                    Showing first 100 of <t t-esc="len(data.get('orders', []))"/> records.
                </p>
            </t>
        </t>
    </template>

    <record id="report_sales_template" model="ir.actions.report">
        <field name="name">AI Sales Report</field>
        <field name="model">ai.report.history</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ai_report_agent.report_sales_document</field>
        <field name="report_file">ai_report_agent.report_sales_document</field>
        <field name="binding_model_id" ref="model_ai_report_history"/>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- ================================================================
         Invoice Report Template
         ================================================================ -->
    <template id="report_invoice_document" name="AI Invoice Report">
        <t t-set="report_title">Invoice Report</t>
        <t t-call="ai_report_agent.report_layout_base">
            <!-- KPI Cards -->
            <div class="row mb-4">
                <div class="col-3">
                    <div class="card border-primary">
                        <div class="card-body text-center">
                            <h6 class="text-primary">Total Invoiced</h6>
                            <h4 t-esc="'{:,.2f}'.format(data.get('total_invoiced', 0))"/>
                        </div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="card border-success">
                        <div class="card-body text-center">
                            <h6 class="text-success">Paid</h6>
                            <h4 t-esc="'{:,.2f}'.format(data.get('total_paid', 0))"/>
                        </div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="card border-warning">
                        <div class="card-body text-center">
                            <h6 class="text-warning">Unpaid</h6>
                            <h4 t-esc="'{:,.2f}'.format(data.get('total_unpaid', 0))"/>
                        </div>
                    </div>
                </div>
                <div class="col-3">
                    <div class="card border-danger">
                        <div class="card-body text-center">
                            <h6 class="text-danger">Overdue</h6>
                            <h4 t-esc="'{:,.2f}'.format(data.get('total_overdue', 0))"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Invoice Table -->
            <t t-if="data.get('invoices')">
                <h4 class="mt-4">Invoice Details</h4>
                <table class="table table-bordered table-sm">
                    <thead class="thead-dark">
                        <tr>
                            <th>Invoice</th>
                            <th>Customer</th>
                            <th>Date</th>
                            <th>Due Date</th>
                            <th class="text-right">Amount</th>
                            <th class="text-right">Residual</th>
                            <th>Payment</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data.get('invoices', [])[:100]" t-as="inv">
                            <tr t-att-class="'table-danger' if inv.get('payment_state') == 'not_paid' and inv.get('due') and inv.get('due') &lt; str(date.today()) else ''">
                                <td t-esc="inv.get('name', '')"/>
                                <td t-esc="inv.get('partner', '')"/>
                                <td t-esc="inv.get('date', '')"/>
                                <td t-esc="inv.get('due', '')"/>
                                <td class="text-right" t-esc="'{:,.2f}'.format(inv.get('amount', 0))"/>
                                <td class="text-right" t-esc="'{:,.2f}'.format(inv.get('residual', 0))"/>
                                <td t-esc="inv.get('payment_state', '')"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </t>
    </template>

    <record id="report_invoice_template" model="ir.actions.report">
        <field name="name">AI Invoice Report</field>
        <field name="model">ai.report.history</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ai_report_agent.report_invoice_document</field>
        <field name="report_file">ai_report_agent.report_invoice_document</field>
        <field name="binding_model_id" ref="model_ai_report_history"/>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- ================================================================
         Inventory Report Template
         ================================================================ -->
    <template id="report_inventory_document" name="AI Inventory Report">
        <t t-set="report_title">Inventory Report</t>
        <t t-call="ai_report_agent.report_layout_base">
            <div class="row mb-4">
                <div class="col-4">
                    <div class="card border-primary">
                        <div class="card-body text-center">
                            <h6 class="text-primary">Total Products</h6>
                            <h3 t-esc="data.get('total_products', 0)"/>
                        </div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="card border-danger">
                        <div class="card-body text-center">
                            <h6 class="text-danger">Low Stock Items</h6>
                            <h3 t-esc="data.get('low_stock_count', 0)"/>
                        </div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="card border-info">
                        <div class="card-body text-center">
                            <h6 class="text-info">Total Qty on Hand</h6>
                            <h3 t-esc="'{:,.2f}'.format(data.get('total_quantity', 0))"/>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Low Stock Alert Table -->
            <t t-if="data.get('low_stock')">
                <h4 class="mt-4 text-danger">Low Stock Alerts</h4>
                <table class="table table-bordered table-sm table-danger">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Location</th>
                            <th class="text-right">On Hand</th>
                            <th class="text-right">Reserved</th>
                            <th class="text-right">Available</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data.get('low_stock', [])" t-as="q">
                            <tr>
                                <td t-esc="q.get('product', '')"/>
                                <td t-esc="q.get('location', '')"/>
                                <td class="text-right" t-esc="'{:,.2f}'.format(q.get('quantity', 0))"/>
                                <td class="text-right" t-esc="'{:,.2f}'.format(q.get('reserved', 0))"/>
                                <td class="text-right" t-esc="'{:,.2f}'.format(q.get('available', 0))"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>

            <!-- Full Stock Table -->
            <t t-if="data.get('quants')">
                <h4 class="mt-4">Stock Levels</h4>
                <table class="table table-striped table-sm">
                    <thead class="thead-dark">
                        <tr>
                            <th>Product</th>
                            <th>Location</th>
                            <th class="text-right">On Hand</th>
                            <th class="text-right">Reserved</th>
                            <th class="text-right">Available</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data.get('quants', [])[:100]" t-as="q">
                            <tr>
                                <td t-esc="q.get('product', '')"/>
                                <td t-esc="q.get('location', '')"/>
                                <td class="text-right" t-esc="'{:,.2f}'.format(q.get('quantity', 0))"/>
                                <td class="text-right" t-esc="'{:,.2f}'.format(q.get('reserved', 0))"/>
                                <td class="text-right" t-esc="'{:,.2f}'.format(q.get('available', 0))"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </t>
    </template>

    <record id="report_inventory_template" model="ir.actions.report">
        <field name="name">AI Inventory Report</field>
        <field name="model">ai.report.history</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ai_report_agent.report_inventory_document</field>
        <field name="report_file">ai_report_agent.report_inventory_document</field>
        <field name="binding_model_id" ref="model_ai_report_history"/>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- ================================================================
         Purchase Report Template
         ================================================================ -->
    <template id="report_purchase_document" name="AI Purchase Report">
        <t t-set="report_title">Purchase Report</t>
        <t t-call="ai_report_agent.report_layout_base">
            <div class="row mb-4">
                <div class="col-4">
                    <div class="card border-primary">
                        <div class="card-body text-center">
                            <h6 class="text-primary">Total Spend</h6>
                            <h3>
                                <t t-esc="data.get('currency', '')"/>
                                <t t-esc="'{:,.2f}'.format(data.get('total_spend', 0))"/>
                            </h3>
                        </div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="card border-success">
                        <div class="card-body text-center">
                            <h6 class="text-success">Total Orders</h6>
                            <h3 t-esc="data.get('order_count', 0)"/>
                        </div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="card border-info">
                        <div class="card-body text-center">
                            <h6 class="text-info">Confirmed</h6>
                            <h3 t-esc="data.get('confirmed_count', 0)"/>
                        </div>
                    </div>
                </div>
            </div>

            <t t-if="data.get('orders')">
                <h4 class="mt-4">Purchase Orders</h4>
                <table class="table table-bordered table-sm">
                    <thead class="thead-dark">
                        <tr>
                            <th>Order</th>
                            <th>Vendor</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th class="text-right">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="data.get('orders', [])[:100]" t-as="order">
                            <tr>
                                <td t-esc="order.get('name', '')"/>
                                <td t-esc="order.get('vendor', '')"/>
                                <td t-esc="order.get('date', '')"/>
                                <td t-esc="order.get('state', '')"/>
                                <td class="text-right" t-esc="'{:,.2f}'.format(order.get('amount', 0))"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </t>
    </template>

    <record id="report_purchase_template" model="ir.actions.report">
        <field name="name">AI Purchase Report</field>
        <field name="model">ai.report.history</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ai_report_agent.report_purchase_document</field>
        <field name="report_file">ai_report_agent.report_purchase_document</field>
        <field name="binding_model_id" ref="model_ai_report_history"/>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- ================================================================
         Summary / KPI Dashboard Template
         ================================================================ -->
    <template id="report_summary_document" name="AI Summary Report">
        <t t-set="report_title">Business Summary Report</t>
        <t t-call="ai_report_agent.report_layout_base">
            <t t-set="kpi" t-value="data.get('kpi', {})"/>

            <!-- KPI Dashboard Row -->
            <div class="row mb-4">
                <div class="col-2">
                    <div class="card border-primary text-center p-2">
                        <small class="text-primary font-weight-bold">Revenue</small>
                        <div class="font-weight-bold" t-esc="'{:,.0f}'.format(kpi.get('total_revenue', 0))"/>
                    </div>
                </div>
                <div class="col-2">
                    <div class="card border-info text-center p-2">
                        <small class="text-info font-weight-bold">Invoiced</small>
                        <div class="font-weight-bold" t-esc="'{:,.0f}'.format(kpi.get('total_invoiced', 0))"/>
                    </div>
                </div>
                <div class="col-2">
                    <div class="card border-warning text-center p-2">
                        <small class="text-warning font-weight-bold">Unpaid</small>
                        <div class="font-weight-bold" t-esc="'{:,.0f}'.format(kpi.get('total_unpaid', 0))"/>
                    </div>
                </div>
                <div class="col-2">
                    <div class="card border-danger text-center p-2">
                        <small class="text-danger font-weight-bold">Overdue</small>
                        <div class="font-weight-bold" t-esc="'{:,.0f}'.format(kpi.get('total_overdue', 0))"/>
                    </div>
                </div>
                <div class="col-2">
                    <div class="card border-warning text-center p-2">
                        <small class="text-warning font-weight-bold">Low Stock</small>
                        <div class="font-weight-bold" t-esc="kpi.get('low_stock_count', 0)"/>
                    </div>
                </div>
                <div class="col-2">
                    <div class="card border-success text-center p-2">
                        <small class="text-success font-weight-bold">Orders</small>
                        <div class="font-weight-bold" t-esc="kpi.get('order_count', 0)"/>
                    </div>
                </div>
            </div>

            <!-- Sales Section -->
            <t t-set="sales" t-value="data.get('sales', {})"/>
            <t t-if="sales.get('top_products')">
                <h4 class="mt-4">Top Selling Products</h4>
                <table class="table table-striped table-sm">
                    <thead class="thead-dark">
                        <tr>
                            <th>#</th><th>Product</th>
                            <th class="text-right">Qty</th>
                            <th class="text-right">Revenue</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="sales.get('top_products', [])[:5]" t-as="prod">
                            <tr>
                                <td t-esc="prod_index + 1"/>
                                <td t-esc="prod.get('name', '')"/>
                                <td class="text-right" t-esc="'{:,.2f}'.format(prod.get('qty', 0))"/>
                                <td class="text-right" t-esc="'{:,.2f}'.format(prod.get('amount', 0))"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>

            <!-- Invoice Section -->
            <t t-set="invoices" t-value="data.get('invoice', {})"/>
            <t t-if="invoices.get('invoices')">
                <h4 class="mt-4">Outstanding Invoices</h4>
                <table class="table table-sm table-bordered">
                    <thead class="thead-dark">
                        <tr>
                            <th>Invoice</th><th>Customer</th>
                            <th>Due</th><th class="text-right">Residual</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="[i for i in invoices.get('invoices',[]) if i.get('payment_state') != 'paid'][:20]" t-as="inv">
                            <tr>
                                <td t-esc="inv.get('name','')"/>
                                <td t-esc="inv.get('partner','')"/>
                                <td t-esc="inv.get('due','')"/>
                                <td class="text-right" t-esc="'{:,.2f}'.format(inv.get('residual',0))"/>
                                <td t-esc="inv.get('payment_state','')"/>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
        </t>
    </template>

    <record id="report_summary_template" model="ir.actions.report">
        <field name="name">AI Summary Report</field>
        <field name="model">ai.report.history</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ai_report_agent.report_summary_document</field>
        <field name="report_file">ai_report_agent.report_summary_document</field>
        <field name="binding_model_id" ref="model_ai_report_history"/>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>
</odoo>
