<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="ai_report_agent.AiChatAction">
    <div class="o_action o_ai_chat d-flex flex-column h-100" style="background:#f8f9fa;">

        <!-- Top bar -->
        <div class="o_ai_chat_topbar d-flex align-items-center px-4 py-3 bg-white border-bottom shadow-sm">
            <i class="fa fa-robot fa-lg text-primary me-2"/>
            <span class="fw-bold fs-5 text-primary">AI Report Chat</span>
            <span class="badge bg-success ms-2" style="font-size:11px;">BETA</span>
            <div class="ms-auto d-flex align-items-center gap-3">
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="checkbox" id="fmtPdf" t-model="state.formatPdf"/>
                    <label class="form-check-label small" for="fmtPdf">
                        <i class="fa fa-file-pdf-o text-danger me-1"/>PDF
                    </label>
                </div>
                <div class="form-check form-check-inline mb-0">
                    <input class="form-check-input" type="checkbox" id="fmtXlsx" t-model="state.formatXlsx"/>
                    <label class="form-check-label small" for="fmtXlsx">
                        <i class="fa fa-file-excel-o text-success me-1"/>Excel
                    </label>
                </div>
            </div>
        </div>

        <!-- Chat scroll area -->
        <div class="o_ai_chat_messages flex-grow-1 overflow-auto px-4 py-3" t-ref="chatScroll">

            <!-- Empty state -->
            <t t-if="state.messages.length === 0">
                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-center text-muted py-5">
                    <i class="fa fa-robot fa-4x mb-3 text-primary opacity-50"/>
                    <h5 class="fw-bold">Halo! Saya AI Report Agent</h5>
                    <p class="small mb-4">
                        Ketik permintaan laporan dalam Bahasa Indonesia atau Inggris.<br/>
                        Contoh: <em>"Laporan penjualan bulan ini"</em> atau <em>"Faktur belum dibayar"</em>
                    </p>
                    <!-- Quick prompts in empty state -->
                    <div class="d-flex flex-wrap gap-2 justify-content-center" style="max-width:600px;">
                        <t t-foreach="quickPrompts" t-as="prompt" t-key="prompt">
                            <button class="btn btn-sm btn-outline-primary rounded-pill"
                                    t-on-click="() => this.setPrompt(prompt)">
                                <t t-esc="prompt"/>
                            </button>
                        </t>
                    </div>
                </div>
            </t>

            <!-- Messages -->
            <t t-foreach="state.messages" t-as="msg" t-key="msg_index">

                <!-- User message (right) -->
                <t t-if="msg.role === 'user'">
                    <div class="d-flex justify-content-end mb-3">
                        <div class="o_ai_chat_bubble_user rounded-3 px-3 py-2 text-white"
                             style="background:#0d6efd; max-width:70%;">
                            <t t-esc="msg.text"/>
                        </div>
                    </div>
                </t>

                <!-- AI message (left) -->
                <t t-if="msg.role === 'ai'">
                    <div class="d-flex justify-content-start mb-3">
                        <div class="me-2 mt-1">
                            <i class="fa fa-robot fa-lg text-primary"/>
                        </div>
                        <div style="max-width:75%;">

                            <!-- Loading -->
                            <t t-if="msg.loading">
                                <div class="o_ai_chat_bubble_ai rounded-3 px-3 py-2 bg-white border">
                                    <i class="fa fa-spinner fa-spin text-primary me-1"/>
                                    <span class="text-muted small">Memproses permintaan...</span>
                                </div>
                            </t>

                            <!-- Error -->
                            <t t-elif="msg.error">
                                <div class="o_ai_chat_bubble_ai rounded-3 px-3 py-2 bg-white border border-danger">
                                    <i class="fa fa-exclamation-triangle text-danger me-1"/>
                                    <span class="text-danger small"><t t-esc="msg.error"/></span>
                                </div>
                            </t>

                            <!-- Success -->
                            <t t-else="">
                                <div class="o_ai_chat_bubble_ai rounded-3 px-3 py-2 bg-white border">
                                    <!-- Insight text -->
                                    <p class="mb-2 small"><t t-esc="msg.text"/></p>

                                    <!-- Clarification -->
                                    <div t-if="msg.clarification" class="alert alert-warning py-1 px-2 mb-2 small">
                                        <i class="fa fa-info-circle me-1"/>
                                        <t t-esc="msg.clarification"/>
                                    </div>

                                    <!-- Result metadata -->
                                    <t t-if="msg.result and msg.result.record_count != null">
                                        <div class="text-muted small mb-2">
                                            <i class="fa fa-table me-1"/>
                                            <t t-esc="msg.result.record_count"/> records
                                            <t t-if="msg.result.date_from">
                                                &amp;nbsp;•&amp;nbsp;
                                                <t t-esc="msg.result.date_from"/>
                                                <t t-if="msg.result.date_to"> – <t t-esc="msg.result.date_to"/></t>
                                            </t>
                                        </div>
                                    </t>

                                    <!-- Download buttons -->
                                    <t t-if="msg.result and msg.result.download_urls">
                                        <div class="d-flex flex-wrap gap-2">
                                            <a t-if="msg.result.download_urls.pdf"
                                               t-att-href="msg.result.download_urls.pdf"
                                               class="btn btn-sm btn-outline-danger" target="_blank">
                                                <i class="fa fa-file-pdf-o me-1"/>Download PDF
                                            </a>
                                            <a t-if="msg.result.download_urls.xlsx"
                                               t-att-href="msg.result.download_urls.xlsx"
                                               class="btn btn-sm btn-outline-success" target="_blank">
                                                <i class="fa fa-file-excel-o me-1"/>Download Excel
                                            </a>
                                            <a t-if="msg.result.history_id"
                                               t-att-href="'/web#model=ai.report.history&amp;id=' + msg.result.history_id"
                                               class="btn btn-sm btn-outline-secondary" target="_blank">
                                                <i class="fa fa-history me-1"/>Riwayat
                                            </a>
                                        </div>
                                    </t>

                                    <!-- Queued state -->
                                    <t t-if="msg.queued">
                                        <div class="alert alert-info py-1 px-2 mt-2 small mb-0">
                                            <i class="fa fa-clock-o me-1"/>
                                            Laporan diproses di background.
                                            <a t-if="msg.result and msg.result.history_id"
                                               t-att-href="'/web#model=ai.report.history&amp;id=' + msg.result.history_id">
                                                Pantau progress
                                            </a>
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </div>
                </t>

            </t>
        </div>

        <!-- Quick prompts (shown when there are messages) -->
        <div t-if="state.messages.length > 0" class="px-4 pt-2 pb-1 bg-white border-top">
            <div class="d-flex flex-wrap gap-1">
                <t t-foreach="quickPrompts" t-as="prompt" t-key="prompt">
                    <button class="btn btn-xs btn-outline-secondary rounded-pill"
                            style="font-size:11px; padding:2px 10px;"
                            t-on-click="() => this.setPrompt(prompt)">
                        <t t-esc="prompt"/>
                    </button>
                </t>
            </div>
        </div>

        <!-- Input area -->
        <div class="o_ai_chat_input_area px-4 py-3 bg-white border-top">
            <div class="input-group">
                <textarea
                    class="form-control"
                    rows="2"
                    placeholder="Ketik permintaan laporan... (Enter untuk kirim, Shift+Enter untuk baris baru)"
                    t-model="state.input"
                    t-on-keydown="onKeydown"
                    t-ref="chatInput"
                    t-att-disabled="state.loading"
                    style="resize:none;"/>
                <button class="btn btn-primary"
                        t-on-click="sendMessage"
                        t-att-disabled="state.loading or !state.input.trim()">
                    <t t-if="state.loading">
                        <i class="fa fa-spinner fa-spin"/>
                    </t>
                    <t t-else="">
                        <i class="fa fa-paper-plane"/>
                    </t>
                </button>
            </div>
        </div>

    </div>
</t>

</templates>
