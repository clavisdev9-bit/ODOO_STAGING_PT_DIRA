<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <!-- ================================================================
         AIReportPanel — Discuss thread panel component
         ================================================================ -->
    <t t-name="ai_report_agent.AIReportPanel">
        <div class="ai-report-panel o_mail_thread_message_list_component">
            <!-- Header -->
            <div class="ai-report-header d-flex align-items-center mb-3">
                <i class="fa fa-robot fa-lg text-primary me-2"/>
                <h6 class="mb-0 text-primary fw-bold">AI Report Agent</h6>
                <span class="badge bg-success ms-2" style="font-size:10px;">BETA</span>
            </div>

            <!-- Quick prompt buttons -->
            <div class="ai-report-quick-prompts mb-3">
                <p class="text-muted small mb-2">Quick Prompts:</p>
                <div class="d-flex flex-wrap gap-1">
                    <t t-foreach="quickPrompts" t-as="prompt" t-key="prompt">
                        <button class="btn btn-sm btn-outline-primary"
                                t-att-title="prompt"
                                t-on-click="() => this.setPrompt(prompt)">
                            <t t-esc="prompt"/>
                        </button>
                    </t>
                </div>
            </div>

            <!-- Input area -->
            <div class="ai-report-input-area">
                <div class="input-group">
                    <textarea
                        class="form-control"
                        rows="3"
                        placeholder="Ask for a report in any language... e.g. 'unpaid invoices this month' or 'laporan penjualan bulan ini'"
                        t-model="state.message"
                        t-on-keydown="onKeydown"
                        t-ref="messageInput"
                        t-att-disabled="state.loading"/>
                    <button class="btn btn-primary"
                            t-on-click="generateReport"
                            t-att-disabled="state.loading or !state.message.trim()">
                        <t t-if="state.loading">
                            <i class="fa fa-spinner fa-spin me-1"/>
                            Generating...
                        </t>
                        <t t-else="">
                            <i class="fa fa-magic me-1"/>
                            Generate
                        </t>
                    </button>
                </div>
            </div>

            <!-- Format options -->
            <div class="ai-report-format-options mt-2 d-flex gap-3">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="fmtPdf"
                           t-model="state.formatPdf"/>
                    <label class="form-check-label" for="fmtPdf">
                        <i class="fa fa-file-pdf-o text-danger me-1"/>PDF
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="fmtXlsx"
                           t-model="state.formatXlsx"/>
                    <label class="form-check-label" for="fmtXlsx">
                        <i class="fa fa-file-excel-o text-success me-1"/>Excel
                    </label>
                </div>
            </div>

            <!-- Clarification banner -->
            <div t-if="state.clarification" class="alert alert-warning mt-3 small">
                <i class="fa fa-info-circle me-1"/>
                <t t-esc="state.clarification"/>
            </div>

            <!-- Result area -->
            <div t-if="state.result" class="ai-report-result mt-3 p-3 border rounded bg-light">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong><i class="fa fa-check-circle text-success me-1"/>Report Ready</strong>
                    <small class="text-muted">
                        <t t-esc="state.result.record_count || 0"/> records •
                        <t t-esc="state.result.date_from"/> → <t t-esc="state.result.date_to"/>
                    </small>
                </div>
                <div class="d-flex gap-2">
                    <a t-if="state.result.download_urls and state.result.download_urls.pdf"
                       t-att-href="state.result.download_urls.pdf"
                       class="btn btn-sm btn-outline-danger" target="_blank">
                        <i class="fa fa-file-pdf-o me-1"/>Download PDF
                    </a>
                    <a t-if="state.result.download_urls and state.result.download_urls.xlsx"
                       t-att-href="state.result.download_urls.xlsx"
                       class="btn btn-sm btn-outline-success" target="_blank">
                        <i class="fa fa-file-excel-o me-1"/>Download Excel
                    </a>
                    <a t-if="state.result.history_id"
                       t-att-href="'/web#model=ai.report.history&amp;id=' + state.result.history_id"
                       class="btn btn-sm btn-outline-secondary" target="_blank">
                        <i class="fa fa-history me-1"/>View History
                    </a>
                </div>
                <div t-if="state.result.insight" class="mt-2 text-muted small">
                    <i class="fa fa-lightbulb-o me-1"/>
                    <t t-esc="state.result.insight"/>
                </div>
            </div>

            <!-- Queued state -->
            <div t-if="state.queued" class="alert alert-info mt-3 small">
                <i class="fa fa-clock-o me-1"/>
                Large dataset detected. Report is being processed in the background.
                You will receive a notification when it's ready.
                <a t-if="state.result and state.result.history_id"
                   t-att-href="'/web#model=ai.report.history&amp;id=' + state.result.history_id">
                    Track progress
                </a>
            </div>

            <!-- Error state -->
            <div t-if="state.error" class="alert alert-danger mt-3 small">
                <i class="fa fa-exclamation-triangle me-1"/>
                <t t-esc="state.error"/>
            </div>
        </div>
    </t>

    <!-- ================================================================
         AIReportButton — Button injected into Discuss action bar
         ================================================================ -->
    <t t-name="ai_report_agent.AIReportButton">
        <button class="o_ai_report_toggle_btn btn btn-sm btn-outline-primary"
                title="Open AI Report Agent"
                t-on-click="togglePanel">
            <i class="fa fa-robot me-1"/>
            <span class="d-none d-md-inline">AI Report</span>
        </button>
    </t>

</templates>
