<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Cron: Process async report queue every 5 minutes -->
    <record id="ir_cron_ai_report_queue" model="ir.cron">
        <field name="name">AI Report: Process Queue</field>
        <field name="model_id" ref="model_ai_report_queue"/>
        <field name="state">code</field>
        <field name="code">model.process_queue()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
        <field name="priority">10</field>
    </record>
</odoo>
