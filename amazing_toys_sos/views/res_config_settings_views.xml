<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Halaman Settings SOS – bagian "Integrasi" (kiri sidebar settings Odoo)
        Berisi tab/block "Integration with Odoo"
        Tombol "Simpan" (bawaan Odoo) otomatis memanggil execute() yang sudah
        di-override → simpan + test + tampil notifikasi error code.
    -->
    <record id="res_config_settings_view_sos_integration" model="ir.ui.view">
        <field name="name">res.config.settings.view.sos.integration</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/app[last()]" position="after">

                <!-- ================================================== -->
                <!--  APP: Integrasi                                     -->
                <!-- ================================================== -->
                <app string="Integrasi" name="amazing_toys_sos"
                     groups="base.group_system">

                    <!-- Block: Integration with Odoo -->
                    <block title="Integration with Odoo"
                           id="sos_odoo_integration_block">

                        <!-- API Key -->
                        <setting
                            string="SOS API Key"
                            help="Kunci autentikasi yang digunakan aplikasi Self-Ordering System (SOS) saat mengirim request ke Odoo (header X-SOS-API-KEY).">
                            <div class="content-group">
                                <div class="mt8">
                                    <label for="sos_api_key" string="API Key"
                                           class="o_light_label"/>
                                    <field name="sos_api_key"
                                           class="oe_inline"
                                           placeholder="Masukkan SOS API Key..."
                                           password="True"/>
                                </div>
                            </div>
                        </setting>

                        <!-- Tombol test koneksi -->
                        <setting string="Test Koneksi">
                            <div class="content-group">
                                <div class="mt8">
                                    <p class="text-muted mb8">
                                        Verifikasi apakah konfigurasi integrasi SOS-Odoo sudah benar
                                        tanpa harus menyimpan perubahan terlebih dahulu.
                                    </p>
                                    <button name="action_sos_test_connection"
                                            string="Test Koneksi Sekarang"
                                            type="object"
                                            class="btn btn-secondary"
                                            icon="fa-plug"/>
                                </div>
                            </div>
                        </setting>

                        <!-- Hasil test terakhir (read-only, otomatis diisi saat test) -->
                        <setting
                            string="Hasil Test Terakhir"
                            help="Diisi otomatis setiap kali test koneksi dijalankan (manual maupun saat Simpan).">
                            <div class="content-group">
                                <div class="mt8">
                                    <label for="sos_last_test_result"
                                           string="Status"
                                           class="o_light_label"/>
                                    <field name="sos_last_test_result"
                                           class="oe_inline"
                                           readonly="1"/>
                                </div>
                                <div class="mt4">
                                    <label for="sos_last_test_date"
                                           string="Waktu"
                                           class="o_light_label"/>
                                    <field name="sos_last_test_date"
                                           class="oe_inline"
                                           readonly="1"/>
                                </div>
                            </div>
                        </setting>

                    </block>

                    <!-- Block: Kode Error Referensi -->
                    <block title="Referensi Kode Error" id="sos_error_code_reference_block">
                        <setting string="Panduan Kode Error">
                            <div class="content-group">
                                <div class="mt8">
                                    <table class="table table-sm table-bordered small">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Kode</th>
                                                <th>Penyebab</th>
                                                <th>Solusi</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td><code>SOS-E001</code></td>
                                                <td>API key belum dikonfigurasi</td>
                                                <td>Isi field "SOS API Key" di atas lalu klik Simpan</td>
                                            </tr>
                                            <tr>
                                                <td><code>SOS-E002</code></td>
                                                <td>Model sale.order tidak dapat diakses</td>
                                                <td>Pastikan modul <em>sale_stock</em> terinstall dan hak akses admin benar</td>
                                            </tr>
                                            <tr>
                                                <td><code>SOS-E003</code></td>
                                                <td>Tidak ada warehouse untuk perusahaan ini</td>
                                                <td>Buat minimal 1 warehouse di Inventory → Konfigurasi → Gudang</td>
                                            </tr>
                                            <tr>
                                                <td><code>SOS-E004</code></td>
                                                <td>Model product.product tidak dapat diakses</td>
                                                <td>Pastikan modul <em>stock</em> terinstall</td>
                                            </tr>
                                            <tr>
                                                <td><code>SOS-E005</code></td>
                                                <td>Admin user tidak ditemukan</td>
                                                <td>Periksa user "Administrator" di Settings → Users</td>
                                            </tr>
                                            <tr>
                                                <td><code>SOS-E006</code></td>
                                                <td>Error tidak terduga</td>
                                                <td>Lihat file log Odoo (odoo18.log) untuk detail teknis</td>
                                            </tr>
                                            <tr class="table-success">
                                                <td><code>SOS-OK</code></td>
                                                <td colspan="2">Integrasi berfungsi normal — semua komponen terverifikasi</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </setting>
                    </block>

                </app>

            </xpath>
        </field>
    </record>


    <!-- Action: buka Settings langsung ke section Integrasi SOS -->
    <record id="action_sos_integration_settings" model="ir.actions.act_window">
        <field name="name">Integrasi SOS</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'amazing_toys_sos', 'bin_size': False}</field>
    </record>

</odoo>
