<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Tambahkan field "No. Transaksi SOS" (sos_txn_number) ke form sale.order.
        Ditampilkan hanya jika order berasal dari SOS (sos_order = True).
    -->
    <record id="view_order_form_inherit_sos_txn" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.sos.txn</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <!-- Tambah field sos_order sebagai invisible untuk referensi kondisi -->
            <xpath expr="//field[@name='name']" position="before">
                <field name="sos_order" invisible="True"/>
            </xpath>

            <!-- Tampilkan No. Transaksi SOS di header, di samping nomor SO -->
            <xpath expr="//field[@name='name']" position="after">
                <field name="sos_txn_number"
                       string="No. Transaksi SOS"
                       invisible="not sos_order"
                       readonly="True"
                       class="o_field_highlight"/>
            </xpath>

        </field>
    </record>


    <!--
        Filter & Group By di list view sale.order:
        - Filter: "SOS Orders"
        - Search by: No. Transaksi SOS
    -->
    <record id="view_sales_order_filter_inherit_sos" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.sos</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">

            <xpath expr="//search/field[last()]" position="after">
                <field name="sos_txn_number" string="No. Transaksi SOS"
                       filter_domain="[('sos_txn_number', 'ilike', self)]"/>
            </xpath>

            <xpath expr="//search/filter[last()]" position="after">
                <separator/>
                <filter name="filter_sos_orders"
                        string="SOS Orders"
                        domain="[('sos_order', '=', True)]"/>
            </xpath>

        </field>
    </record>

</odoo>
