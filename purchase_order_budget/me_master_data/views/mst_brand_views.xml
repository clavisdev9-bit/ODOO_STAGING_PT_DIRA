<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mst_brand_tree" model="ir.ui.view">
        <field name="name">x.mst.brand.tree</field>
        <field name="model">x.mst.brand</field>
        <field name="arch" type="xml">
            <list string="Master Brand">
                <field name="no_urut" readonly="1"/>
                <field name="kode"/>
                <field name="name"/>
                <field name="negara_asal"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="view_mst_brand_form" model="ir.ui.view">
        <field name="name">x.mst.brand.form</field>
        <field name="model">x.mst.brand</field>
        <field name="arch" type="xml">
            <form string="Master Brand">
                <sheet>
                    <div class="alert alert-info mb-3" role="status">
                        <p class="mb-0">
                            <strong>No. Urut</strong> dibuat otomatis secara global.
                            <strong>Kode (4chr)</strong> wajib unik dan digunakan sebagai bagian dari Kode Item.
                        </p>
                    </div>
                    <group>
                        <group>
                            <field name="no_urut" readonly="1"
                                   help="Nomor urut diisi otomatis saat data disimpan"/>
                            <field name="kode" placeholder="Contoh: SCHN, ABB, SIEM"
                                   help="Maksimal 4 karakter, harus unik"/>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="negara_asal" placeholder="Contoh: Jerman, Jepang, Indonesia"/>
                            <field name="is_active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mst_brand" model="ir.actions.act_window">
        <field name="name">Master Brand</field>
        <field name="res_model">x.mst.brand</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
