<odoo>
    <record id="view_purchase_order_form_inherit" model="ir.ui.view">
        <field name="name">purchase.order.line.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <header>
                    <button name="button_manager" type="object" string="Approve Manager" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="button_cancel" type="object" string="Cancel" class="btn-secondary" invisible="state != 'confirmed'"/>
                </header>
            </xpath>
            <!--<xpath expr="//header/button[@name='action_preview_sale_order']" position="replace">
                <button name="action_preview_sale_order" string="Preview" type="object" class="btn-secondary" invisible="state in ['confirm', 'manager']"/>
            </xpath>-->
            <xpath expr="//field[@name='order_line']/list/field[@name='taxes_id']" position="after">
                <field name="budget_id"/>
                <field name="budget_line_id"/>
            </xpath>
        </field>
    </record>
</odoo>