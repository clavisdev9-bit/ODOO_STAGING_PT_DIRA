<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_hr_expense_sheet_form_inherit" model="ir.ui.view">
        <field name="name">hr.expense.sheet.form.inherit.approve</field>
        <field name="model">hr.expense.sheet</field>
        <field name="inherit_id" ref="hr_expense.view_hr_expense_sheet_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header//button[@name='action_approve_expense_sheets']" position="attributes">
                <attribute name="confirm">
                    Apakah Anda yakin telah mengisi Analytic Distribution dan Journal sudah sesuai?
                </attribute>
            </xpath>
            <xpath expr="//field[@name='expense_line_ids']/list/field[@name='analytic_distribution']" position="attributes">
                <attribute name="required">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>