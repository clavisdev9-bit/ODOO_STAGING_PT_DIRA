<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===== Client action — S-Curve Dashboard ===== -->
    <record id="action_scurve_dashboard" model="ir.actions.client">
        <field name="name">S-Curve Dashboard</field>
        <field name="tag">project_scurve.SCurveDashboard</field>
        <field name="context">{'default_project_id': active_id}</field>
    </record>

    <!-- ===== Client action — All Projects S-Curve list ===== -->
    <record id="action_scurve_dashboard_all" model="ir.actions.client">
        <field name="name">S-Curve Monitor</field>
        <field name="tag">project_scurve.SCurveDashboard</field>
    </record>

    <!-- ===== Menu item under Project → Reporting ===== -->
    <menuitem id="menu_project_scurve"
              name="S-Curve Monitor"
              parent="project.menu_reporting"
              action="action_scurve_dashboard_all"
              sequence="25"/>

</odoo>
