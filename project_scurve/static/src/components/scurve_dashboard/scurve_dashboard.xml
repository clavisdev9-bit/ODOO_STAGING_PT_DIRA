<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

<t t-name="project_scurve.SCurveDashboard" owl="1">
    <div class="scurve-dashboard o_action">

        <!-- ── Header ─────────────────────────────────────── -->
        <div class="scurve-header">
            <h2 class="scurve-title">
                <i class="fa fa-line-chart me-2"/>
                <t t-if="state.projectName">
                    <t t-esc="state.projectName"/> —
                </t>
                S-Curve Monitor
            </h2>
        </div>

        <!-- ── Loading spinner ────────────────────────────── -->
        <div t-if="state.loading" class="scurve-loading">
            <div class="o_loading_indicator">
                <i class="fa fa-spinner fa-spin fa-2x"/>
                <span class="ms-2">Loading S-Curve data…</span>
            </div>
        </div>

        <!-- ── Error state ────────────────────────────────── -->
        <div t-elif="state.error" class="scurve-error alert alert-danger m-3">
            <i class="fa fa-exclamation-triangle me-2"/>
            <t t-esc="state.error"/>
        </div>

        <!-- ── No project selected ────────────────────────── -->
        <div t-elif="!state.projectId" class="scurve-empty">
            <i class="fa fa-folder-open-o fa-3x mb-3"/>
            <p>No project selected. Open a project and click the S-Curve button.</p>
        </div>

        <!-- ── Empty state (project has no week numbers) ──── -->
        <div t-elif="!hasData" class="scurve-empty">
            <i class="fa fa-bar-chart fa-3x mb-3"/>
            <h4>No S-Curve data yet</h4>
            <p>
                To display the S-Curve, open each task in this project and set a
                <strong>Week No.</strong> (1–52) in the task form.
                Actual progress is recorded via Timesheets.
            </p>
        </div>

        <!-- ── Main dashboard ─────────────────────────────── -->
        <div t-else="" class="scurve-body">

            <!-- KPI Cards -->
            <div class="scurve-kpi-row">

                <div class="scurve-kpi-card">
                    <div class="scurve-kpi-label">Plan (BCR)</div>
                    <div class="scurve-kpi-value">
                        <t t-esc="formatPct(state.kpis.current_bcr)"/>
                    </div>
                    <div class="scurve-kpi-sub">Cumulative planned weight</div>
                </div>

                <div class="scurve-kpi-card">
                    <div class="scurve-kpi-label">Actual (BCA)</div>
                    <div t-attf-class="scurve-kpi-value {{ deviationClass }}">
                        <t t-esc="formatPct(state.kpis.current_bca)"/>
                    </div>
                    <div class="scurve-kpi-sub">Cumulative actual weight</div>
                </div>

                <div class="scurve-kpi-card">
                    <div class="scurve-kpi-label">Deviation</div>
                    <div t-attf-class="scurve-kpi-value {{ deviationClass }}">
                        <t t-esc="formatPct(state.kpis.deviation)"/>
                    </div>
                    <div class="scurve-kpi-sub">
                        <span t-attf-class="scurve-badge scurve-badge--{{ state.kpis.status }}">
                            <t t-esc="state.kpis.status_label"/>
                        </span>
                    </div>
                </div>

                <div class="scurve-kpi-card">
                    <div class="scurve-kpi-label">Forecast Finish</div>
                    <div t-attf-class="scurve-kpi-value {{ forecastClass }}">
                        <t t-esc="forecastText"/>
                    </div>
                    <div class="scurve-kpi-sub">vs planned end week</div>
                </div>

            </div>

            <!-- Phase Tabs -->
            <div class="scurve-tabs">
                <button
                    t-attf-class="scurve-tab {{ state.activePhaseId === 'all' ? 'active' : '' }}"
                    t-on-click="() => setPhase('all')">
                    All Phases
                </button>
                <t t-foreach="state.milestones" t-as="ms" t-key="ms.id">
                    <button
                        t-attf-class="scurve-tab {{ state.activePhaseId === ms.id ? 'active' : '' }}"
                        t-on-click="() => setPhase(ms.id)">
                        <t t-esc="ms.name"/>
                    </button>
                </t>
            </div>

            <!-- Chart -->
            <div class="scurve-chart-container">
                <div class="scurve-legend">
                    <span class="scurve-legend-item">
                        <span class="scurve-legend-dot" style="background:#185FA5;"/>
                        Rencana (Plan)
                    </span>
                    <span class="scurve-legend-item">
                        <span class="scurve-legend-dot" style="background:#0F6E56;"/>
                        Realisasi (Actual)
                    </span>
                    <span class="scurve-legend-item">
                        <span class="scurve-legend-dot scurve-legend-dot--dashed" style="background:#BA7517;"/>
                        Proyeksi (Forecast)
                    </span>
                </div>
                <div class="scurve-canvas-wrap">
                    <canvas t-ref="scurveChart"
                            role="img"
                            aria-label="S-Curve: Cumulative planned vs actual project weight by week"/>
                </div>
            </div>

            <!-- Milestone Summary Table -->
            <div class="scurve-milestone-section" t-if="state.milestones.length">
                <h4 class="scurve-section-title">Milestone Summary</h4>
                <table class="scurve-milestone-table table table-sm">
                    <thead>
                        <tr>
                            <th>Milestone / Phase</th>
                            <th class="text-end">Plan %</th>
                            <th class="text-end">Actual %</th>
                            <th class="text-end">Deviation</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="state.milestones" t-as="ms" t-key="ms.id">
                            <tr>
                                <td><strong t-esc="ms.name"/></td>
                                <td class="text-end"><t t-esc="formatPct(ms.bcr)"/></td>
                                <td class="text-end"><t t-esc="formatPct(ms.bca)"/></td>
                                <td t-attf-class="text-end {{ ms.deviation >= 0 ? 'text-success' : (ms.deviation > -15 ? 'text-warning' : 'text-danger') }}">
                                    <t t-esc="formatPct(ms.deviation)"/>
                                </td>
                                <td class="text-center">
                                    <span t-attf-class="scurve-badge scurve-badge--{{ ms.status }}">
                                        <t t-esc="statusIcon(ms.status)"/>
                                        <t t-esc="ms.status_label"/>
                                    </span>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>

            <!-- How-to-read info box -->
            <div class="scurve-info-box">
                <div class="scurve-info-header" t-on-click="toggleInfo">
                    <i t-attf-class="fa {{ state.infoExpanded ? 'fa-chevron-down' : 'fa-chevron-right' }} me-2"/>
                    <strong>How to read the S-Curve</strong>
                </div>
                <div t-if="state.infoExpanded" class="scurve-info-body">
                    <p>
                        <strong>X-axis</strong> = time (weeks) ·
                        <strong>Y-axis</strong> = cumulative weight (%).
                    </p>
                    <p>
                        The "S" shape occurs because work ramps up slowly at the start
                        (mobilisation), accelerates in the middle (peak production), then
                        slows at the end (finishing &amp; handover).
                    </p>
                    <p>
                        The gap between the <span style="color:#185FA5;font-weight:600;">Plan</span>
                        and <span style="color:#0F6E56;font-weight:600;">Actual</span> lines shows
                        schedule deviation. A negative gap means the project is
                        <strong>behind schedule</strong>.
                        The <span style="color:#BA7517;font-weight:600;">Forecast</span> line
                        (dashed) is a linear extrapolation of the current progress velocity.
                    </p>
                    <ul>
                        <li><span class="scurve-badge scurve-badge--ahead">Ahead</span> — BCA &gt; BCR</li>
                        <li><span class="scurve-badge scurve-badge--on_track">On Track</span> — deviation within −5%</li>
                        <li><span class="scurve-badge scurve-badge--late">Late</span> — deviation between −5% and −15%</li>
                        <li><span class="scurve-badge scurve-badge--critical">Critical</span> — deviation ≤ −15%</li>
                    </ul>
                </div>
            </div>

        </div><!-- /scurve-body -->

    </div><!-- /scurve-dashboard -->
</t>

</templates>
