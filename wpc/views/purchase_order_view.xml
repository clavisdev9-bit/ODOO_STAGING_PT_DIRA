<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_purchase_order_form_warning" model="ir.ui.view">
        <field name="name">purchase.order.form.waring</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="after">
                <div class="alert alert-warning" style="height:40px, width:30px, margin-bottom:1px;" invisible="warning == '' or state != 'draft'">
                    <field name="warning"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>