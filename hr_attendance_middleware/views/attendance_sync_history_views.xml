<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="hr_attendance_sync_history_view_list" model="ir.ui.view">
        <field name="name">hr.attendance.sync.history.list</field>
        <field name="model">hr.attendance.sync.history</field>
        <field name="arch" type="xml">
            <list string="Riwayat Sync" decoration-danger="state == 'error'"
                  decoration-warning="state == 'partial'" decoration-muted="state == 'running'"
                  create="false" delete="false">
                <field name="started_at"/>
                <field name="device_id"/>
                <field name="sync_type" widget="badge"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'success'"
                       decoration-warning="state == 'partial'"
                       decoration-danger="state == 'error'"
                       decoration-info="state == 'running'"/>
                <field name="total_raw"/>
                <field name="total_processed"/>
                <field name="total_skipped"/>
                <field name="total_errors"/>
                <field name="duration" string="Durasi (detik)"/>
                <field name="triggered_by" optional="show"/>
                <button name="action_view_raw_logs" string="Lihat Log" type="object"
                        icon="fa-list" class="btn-sm"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="hr_attendance_sync_history_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.sync.history.form</field>
        <field name="model">hr.attendance.sync.history</field>
        <field name="arch" type="xml">
            <form string="Riwayat Sinkronisasi" create="false">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="running,success,partial,error"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_raw_logs" icon="fa-list">
                            <field name="raw_log_count" widget="statinfo" string="Log Raw"/>
                        </button>
                    </div>
                    <group>
                        <group string="Informasi Sesi">
                            <field name="name"/>
                            <field name="device_id"/>
                            <field name="sync_type"/>
                            <field name="triggered_by"/>
                        </group>
                        <group string="Waktu">
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="duration" string="Durasi (detik)"/>
                        </group>
                    </group>
                    <group string="Statistik">
                        <group>
                            <field name="total_raw"/>
                            <field name="total_processed"/>
                        </group>
                        <group>
                            <field name="total_skipped"/>
                            <field name="total_errors"/>
                        </group>
                    </group>
                    <group string="Ringkasan">
                        <field name="summary" nolabel="1" colspan="2" readonly="1"/>
                    </group>
                    <group string="Log Error" invisible="not error_log">
                        <field name="error_log" nolabel="1" colspan="2" readonly="1" widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="hr_attendance_sync_history_view_search" model="ir.ui.view">
        <field name="name">hr.attendance.sync.history.search</field>
        <field name="model">hr.attendance.sync.history</field>
        <field name="arch" type="xml">
            <search string="Cari Riwayat Sync">
                <field name="device_id"/>
                <separator/>
                <filter name="success" string="Berhasil" domain="[('state', '=', 'success')]"/>
                <filter name="error" string="Gagal" domain="[('state', '=', 'error')]"/>
                <filter name="partial" string="Sebagian" domain="[('state', '=', 'partial')]"/>
                <filter name="auto" string="Otomatis" domain="[('sync_type', '=', 'auto')]"/>
                <filter name="manual" string="Manual" domain="[('sync_type', '=', 'manual')]"/>
                <filter name="push" string="Push API" domain="[('sync_type', '=', 'push')]"/>
                <separator/>
                <filter name="today" string="Hari Ini"
                        domain="[('started_at', '>=', datetime.datetime.combine(datetime.date.today(), datetime.time.min))]"/>
                <filter name="this_week" string="Minggu Ini"
                        domain="[('started_at', '>=', (datetime.datetime.today() - datetime.timedelta(weeks=1)).strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Kelompokkan">
                    <filter name="group_device" string="Mesin" context="{'group_by': 'device_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Tanggal" context="{'group_by': 'started_at:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="hr_attendance_sync_history_action" model="ir.actions.act_window">
        <field name="name">Riwayat Sinkronisasi</field>
        <field name="res_model">hr.attendance.sync.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_attendance_sync_history_view_search"/>
    </record>

</odoo>
