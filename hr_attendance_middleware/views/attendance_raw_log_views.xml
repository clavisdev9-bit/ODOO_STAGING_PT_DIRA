<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- LIST VIEW -->
    <record id="hr_attendance_raw_log_view_list" model="ir.ui.view">
        <field name="name">hr.attendance.raw.log.list</field>
        <field name="model">hr.attendance.raw.log</field>
        <field name="arch" type="xml">
            <list string="Log Raw Absensi" decoration-danger="state == 'error'"
                  decoration-muted="state == 'skipped'" create="false" delete="false">
                <field name="device_id"/>
                <field name="employee_uid"/>
                <field name="employee_id"/>
                <field name="raw_timestamp"/>
                <field name="timestamp_utc"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'processed'"
                       decoration-warning="state == 'pending'"
                       decoration-muted="state == 'skipped'"
                       decoration-danger="state == 'error'"/>
                <field name="error_message" optional="show"/>
                <field name="attendance_id" optional="show"/>
                <field name="sync_history_id" optional="show"/>
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="hr_attendance_raw_log_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.raw.log.form</field>
        <field name="model">hr.attendance.raw.log</field>
        <field name="arch" type="xml">
            <form string="Log Raw Absensi" create="false">
                <sheet>
                    <group>
                        <group string="Sumber Data">
                            <field name="device_id"/>
                            <field name="sync_history_id"/>
                            <field name="employee_uid"/>
                            <field name="employee_id"/>
                        </group>
                        <group string="Timestamp">
                            <field name="raw_timestamp"/>
                            <field name="timestamp_utc"/>
                            <field name="state" widget="badge"/>
                        </group>
                    </group>
                    <group string="Hasil Proses" invisible="state not in ('error', 'processed')">
                        <field name="attendance_id"/>
                        <field name="error_message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="hr_attendance_raw_log_view_search" model="ir.ui.view">
        <field name="name">hr.attendance.raw.log.search</field>
        <field name="model">hr.attendance.raw.log</field>
        <field name="arch" type="xml">
            <search string="Cari Log Raw">
                <field name="employee_uid" string="ID Karyawan"/>
                <field name="employee_id"/>
                <field name="device_id"/>
                <separator/>
                <filter name="pending" string="Menunggu" domain="[('state', '=', 'pending')]"/>
                <filter name="processed" string="Diproses" domain="[('state', '=', 'processed')]"/>
                <filter name="error" string="Error" domain="[('state', '=', 'error')]"/>
                <filter name="today" string="Hari Ini"
                        domain="[('timestamp_utc', '>=', datetime.datetime.combine(datetime.date.today(), datetime.time.min))]"/>
                <group expand="0" string="Kelompokkan">
                    <filter name="group_device" string="Mesin" context="{'group_by': 'device_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Tanggal" context="{'group_by': 'timestamp_utc:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION -->
    <record id="hr_attendance_raw_log_action" model="ir.actions.act_window">
        <field name="name">Log Raw Absensi</field>
        <field name="res_model">hr.attendance.raw.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_attendance_raw_log_view_search"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

</odoo>
