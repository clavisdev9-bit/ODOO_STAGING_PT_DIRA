<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_attendance_sync_wizard_view_form" model="ir.ui.view">
        <field name="name">hr.attendance.sync.wizard.form</field>
        <field name="model">hr.attendance.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Sync Manual Absensi">
                <sheet>
                    <group>
                        <field name="device_id"/>
                        <field name="sync_mode"/>
                    </group>
                    <group string="Rentang Tanggal" invisible="sync_mode != 'pull'">
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="clear_existing"/>
                    </group>

                    <!-- Hasil sync -->
                    <group string="Hasil Sinkronisasi" invisible="state == 'draft'">
                        <div class="alert alert-success" invisible="state != 'done'">
                            <strong>Sync Berhasil!</strong><br/>
                            <field name="result_summary" nolabel="1" readonly="1"/>
                        </div>
                        <div class="alert alert-danger" invisible="state != 'error'">
                            <strong>Sync Gagal!</strong><br/>
                            <field name="result_summary" nolabel="1" readonly="1"/>
                        </div>
                    </group>
                </sheet>
                <footer>
                    <button name="action_start_sync" string="Mulai Sync" type="object"
                            class="btn-primary" invisible="state == 'done'"/>
                    <button name="action_view_history" string="Lihat Detail Sync" type="object"
                            class="btn-secondary"
                            invisible="state != 'done' or not sync_history_id"/>
                    <button string="Tutup" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="hr_attendance_sync_wizard_action" model="ir.actions.act_window">
        <field name="name">Sync Manual Absensi</field>
        <field name="res_model">hr.attendance.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
