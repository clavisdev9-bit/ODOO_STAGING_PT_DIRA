<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Kategori -->
    <record id="module_hr_attendance_middleware" model="ir.module.category">
        <field name="name">HR-Attendance Middleware</field>
        <field name="description">Manajemen mesin absensi dan sinkronisasi data kehadiran</field>
        <field name="sequence">10</field>
    </record>

    <!-- Group: Admin -->
    <record id="group_attendance_middleware_admin" model="res.groups">
        <field name="name">Administrator Mesin Absensi</field>
        <field name="category_id" ref="module_hr_attendance_middleware"/>
        <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">
            Dapat membuat, mengubah, dan menghapus konfigurasi mesin absensi.
            Dapat menjalankan sync manual dan melihat semua log.
        </field>
    </record>

    <!-- Group: User (view only) -->
    <!-- implied_ids (hr_attendance.group_hr_attendance) is set via post_init_hook
         to avoid hard ref() failure if hr_attendance data is missing from ir.model.data -->
    <record id="group_attendance_middleware_user" model="res.groups">
        <field name="name">Pengguna Mesin Absensi</field>
        <field name="category_id" ref="module_hr_attendance_middleware"/>
        <field name="comment">
            Dapat melihat daftar mesin dan riwayat sinkronisasi. Tidak dapat mengubah konfigurasi.
        </field>
    </record>

</odoo>
