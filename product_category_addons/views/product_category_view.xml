<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_product_category_form_inherit" model="ir.ui.view">
        <field name="name">product.category.form.inherit</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="code"/>
            </xpath>
        </field>
    </record>

    <record id="action_item_category" model="ir.actions.act_window">
        <field name="name">Item Category</field>
        <field name="res_model">item.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new item
            </p>
        </field>
    </record>

    <record id="action_sub_category" model="ir.actions.act_window">
        <field name="name">Sub Category</field>
        <field name="res_model">sub.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new item
            </p>
        </field>
    </record>

    <record id="action_brand" model="ir.actions.act_window">
        <field name="name">Brand</field>
        <field name="res_model">brand</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new item
            </p>
        </field>
    </record>

    <menuitem id="menu_brand"
              name="Brand"
              parent="stock.menu_product_in_config_stock"
              action="action_brand"
              sequence="9"/>
    <menuitem id="menu_item_category"
              name="Item Category"
              parent="stock.menu_product_in_config_stock"
              action="action_item_category"
              sequence="10"/>
    <menuitem id="menu_sub_category"
              name="Sub Category"
              parent="stock.menu_product_in_config_stock"
              action="action_sub_category"
              sequence="11"/>
</odoo>